+    /// <summary>
+    /// Option chain parameters. Backed by <c>reqSecDefOptParams</c> →
+    /// <c>securityDefinitionOptionParameter*</c> → <c>securityDefinitionOptionParameterEnd</c>.
+    /// </summary>
+    /// <param name="underlyingSymbol">e.g. "SPY".</param>
+    /// <param name="underlyingSecType">"STK", "IND" or "FUT".</param>
+    /// <param name="underlyingConId">The underlying's contract id.</param>
+    /// <param name="futFopExchange">Exchange of a futures underlying; "" for stocks and indices.</param>
+    public Task<IReadOnlyList<OptionChainParameters>> GetOptionChainParametersAsync(
+        string underlyingSymbol,
+        string underlyingSecType,
+        int underlyingConId,
+        string futFopExchange = "",
+        CancellationToken cancellationToken = default)
+    {
+        var reqId = _ids.Next();
+        var acc = new List<OptionChainParameters>();
+        var tcs = NewTcs<IReadOnlyList<OptionChainParameters>>();
+
+        void OnData(int id, string exchange, int conId, string tradingClass, string multiplier,
+            HashSet<string> expirations, HashSet<double> strikes)
+        {
+            if (id == reqId)
+                acc.Add(new OptionChainParameters(
+                    exchange, conId, tradingClass, multiplier,
+                    expirations.Order().ToList(), strikes.Order().ToList()));
+        }
+        void OnEnd(int id) { if (id == reqId) tcs.TrySetResult(acc); }
+
+        return RunRequestAsync(
+            reqId, tcs,
+            subscribe: () =>
+            {
+                _dispatcher.SecurityDefinitionOptionParameterReceived += OnData;
+                _dispatcher.SecurityDefinitionOptionParameterEndReceived += OnEnd;
+            },
+            unsubscribe: () =>
+            {
+                _dispatcher.SecurityDefinitionOptionParameterReceived -= OnData;
+                _dispatcher.SecurityDefinitionOptionParameterEndReceived -= OnEnd;
+            },
+            invokeRequest: () => Socket.reqSecDefOptParams(
+                reqId, underlyingSymbol, futFopExchange, underlyingSecType, underlyingConId),
+            cancellationToken);
+    }
+
