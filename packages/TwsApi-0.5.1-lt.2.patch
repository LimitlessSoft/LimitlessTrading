+    /// <summary>
+    /// Subscribe to account summary values. Backed by <c>reqAccountSummary</c> →
+    /// <c>accountSummary*</c> (initial values, then each change); cancelled
+    /// (<c>cancelAccountSummary</c>) when the enumeration ends.
+    /// </summary>
+    /// <param name="tags">Comma-separated tags, e.g. "NetLiquidation,TotalCashValue,BuyingPower".</param>
+    /// <param name="group">Account group; "All" covers every managed account.</param>
+    public IAsyncEnumerable<AccountValue> SubscribeAccountSummaryAsync(
+        string tags = "NetLiquidation,TotalCashValue,BuyingPower,AvailableFunds",
+        string group = "All",
+        CancellationToken cancellationToken = default)
+    {
+        var reqId = _ids.Next();
+        return StreamAsync<AccountValue>(
+            reqId,
+            wire: writer =>
+            {
+                void OnData(int id, string account, string tag, string value, string currency)
+                {
+                    if (id == reqId) writer.TryWrite(new AccountValue(account, tag, value, currency));
+                }
+                _dispatcher.AccountSummaryReceived += OnData;
+                return new ActionDisposable(() => _dispatcher.AccountSummaryReceived -= OnData);
+            },
+            invokeRequest: () => Socket.reqAccountSummary(reqId, group, tags),
+            invokeCancel: () => Socket.cancelAccountSummary(reqId),
+            errorAppliesToStream: true,
+            cancellationToken);
+    }
