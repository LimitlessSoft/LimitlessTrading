<Project Sdk="Microsoft.NET.Sdk">
	<!-- What indicator scripts are written against, and the only assembly of ours they can see
	     (see docs/indicators.md). References nothing else of LT: no Avalonia, no Contracts. -->
	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>
</Project>
