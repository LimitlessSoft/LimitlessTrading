		<ProjectReference Include="..\Widgets\LT.Widgets.Core\LT.Widgets.Core.csproj" />
		<!-- Chart view model only (dropping a ticker); its view is never created -->
		<ProjectReference Include="..\Widgets\LT.Widgets.Chart\LT.Widgets.Chart.csproj" />
		<!-- DepthFeed only (closing frees the depth slot); no view is created -->
		<ProjectReference Include="..\Widgets\LT.Widgets.Calendar\LT.Widgets.Calendar.csproj" />
		<ProjectReference Include="..\Widgets\LT.Widgets.Depth\LT.Widgets.Depth.csproj" />
		<!-- Watchlist row view model only (market cap); its view is never created -->
		<ProjectReference Include="..\Widgets\LT.Widgets.Watchlist\LT.Widgets.Watchlist.csproj" />
		<!-- Option chain view model only (typing its underlying); its view is never created -->
		<ProjectReference Include="..\Widgets\LT.Widgets.OptionChain\LT.Widgets.OptionChain.csproj" />
		<ProjectReference Include="..\Widgets\LT.Widgets.Overview\LT.Widgets.Overview.csproj" />
		<!-- Notes view model only (per-instance notes); its view is never created -->
		<ProjectReference Include="..\Widgets\LT.Widgets.Notes\LT.Widgets.Notes.csproj" />
		<!-- Messages view model only (copying rows); its view is never created -->
		<ProjectReference Include="..\Widgets\LT.Widgets.Messages\LT.Widgets.Messages.csproj" />
		<!-- Day trade performance row view model only (Side text); its view is never created -->
		<ProjectReference Include="..\Widgets\LT.Widgets.DayTradePerformance\LT.Widgets.DayTradePerformance.csproj" />
		<!-- Workspace model only (moving views between windows); no view or window is created -->
		<ProjectReference Include="..\LT.App\LT.App.csproj" />
