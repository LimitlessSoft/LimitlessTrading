	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<!-- Real feed answers (trimmed) for the RSS / Atom parser -->
	<ItemGroup>
		<None Include="Feeds/Fixtures/*.xml" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
