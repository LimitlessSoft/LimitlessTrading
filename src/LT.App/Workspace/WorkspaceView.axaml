<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Workspace"
	x:Class="LT.App.Workspace.WorkspaceView"
	x:DataType="vm:WorkspaceViewModel"
>
	<UserControl.DataTemplates>
		<!-- Strip icon of a side-docked widget: click toggles it, drag moves it like its header -->
		<DataTemplate DataType="vm:WidgetItem">
			<Button
				Classes="tool"
				Classes.active="{Binding IsActive}"
				Command="{Binding ToggleCommand}"
				ToolTip.Tip="{Binding ToolTip}"
				AttachedToVisualTree="OnStripIconAttached"
			>
				<PathIcon Data="{Binding Icon}" />
			</Button>
		</DataTemplate>
	</UserControl.DataTemplates>

	<!-- strip | left host | splitter | center | splitter | right host | strip -->
	<Grid x:Name="LayoutGrid" ColumnDefinitions="Auto,380,6,*,6,300,Auto">
		<Border x:Name="LeftStrip" Grid.Column="0" Classes="strip" BorderThickness="0,0,1,0">
			<ItemsControl x:Name="LeftIcons" ItemsSource="{Binding Left}" />
		</Border>

		<Border x:Name="LeftHost" Grid.Column="1" />
		<GridSplitter
			x:Name="LeftSplitter"
			Grid.Column="2"
			ResizeDirection="Columns"
			Background="Transparent"
		/>

		<!-- view tabs | center | splitter | bottom host | bottom strip (shown while a widget is docked there) -->
		<Grid x:Name="CenterColumn" Grid.Column="3" RowDefinitions="Auto,*,6,0,Auto">
			<!-- One tab per center view: click shows it, double-click renames, right-click offers
			     Duplicate, ✕ closes it with its widgets; "+" adds one. A widget dragged over a tab
			     switches to that view. -->
			<Border x:Name="ViewTabStrip" Classes="viewTabs">
				<StackPanel Orientation="Horizontal">
					<ItemsControl x:Name="ViewTabs" ItemsSource="{Binding Views}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="2" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="vm:CenterViewItem">
								<Border
									Classes="viewTab"
									Classes.selected="{Binding IsSelected}"
									PointerPressed="OnViewTabPressed"
								>
									<Border.ContextMenu>
										<ContextMenu>
											<MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
										</ContextMenu>
									</Border.ContextMenu>
									<Grid ColumnDefinitions="Auto,Auto">
										<TextBlock
											VerticalAlignment="Center"
											Text="{Binding Name}"
											IsVisible="{Binding !IsRenaming}"
										/>
										<TextBox
											Classes="viewName"
											Text="{Binding RenameText}"
											MaxLength="{Binding NameMaxLength}"
											IsVisible="{Binding IsRenaming}"
											PropertyChanged="OnViewNameBoxPropertyChanged"
											KeyDown="OnViewNameBoxKeyDown"
											LostFocus="OnViewNameBoxLostFocus"
										/>
										<Button
											Grid.Column="1"
											Classes="frameAction close viewClose"
											Command="{Binding CloseCommand}"
											ToolTip.Tip="Close the view and its widgets"
											IsVisible="{Binding CanClose}"
										>
											<PathIcon Data="{StaticResource FrameCloseIcon}" />
										</Button>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button
						Classes="frameAction viewAdd"
						Command="{Binding AddViewCommand}"
						ToolTip.Tip="New view"
					>
						<PathIcon Data="{StaticResource ViewAddIcon}" />
					</Button>
				</StackPanel>
			</Border>

			<Panel x:Name="CenterHost" Grid.Row="1" Margin="0,8">
				<!-- One host per view, built from its split tree (nested grids with splitters);
				     only the shown view's is visible -->
				<Panel x:Name="CenterViews" />
				<TextBlock
					Classes="secondary"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					TextAlignment="Center"
					Text="No widgets in this view.&#10;Open one from the menu, or drag one here by its header."
					IsVisible="{Binding !HasCenterWidgets}"
				/>
			</Panel>

			<GridSplitter
				x:Name="BottomSplitter"
				Grid.Row="2"
				ResizeDirection="Rows"
				Background="Transparent"
			/>
			<Border x:Name="BottomHost" Grid.Row="3" />

			<Border
				x:Name="BottomStrip"
				Grid.Row="4"
				Classes="strip horizontal"
				BorderThickness="0,1,0,0"
				IsVisible="{Binding HasBottomWidgets}"
			>
				<ItemsControl x:Name="BottomIcons" ItemsSource="{Binding Bottom}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</Border>
		</Grid>

		<GridSplitter
			x:Name="RightSplitter"
			Grid.Column="4"
			ResizeDirection="Columns"
			Background="Transparent"
		/>
		<Border x:Name="RightHost" Grid.Column="5" />

		<Border x:Name="RightStrip" Grid.Column="6" Classes="strip" BorderThickness="1,0,0,0">
			<ItemsControl x:Name="RightIcons" ItemsSource="{Binding Right}" />
		</Border>

		<!-- Drag and drop feedback: where the dragged widget will land -->
		<Canvas x:Name="DropOverlay" Grid.ColumnSpan="7" IsVisible="False" IsHitTestVisible="False">
			<Border x:Name="DropHighlight" Classes="dropTarget">
				<TextBlock
					x:Name="DropLabel"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontWeight="SemiBold"
				/>
			</Border>
		</Canvas>
	</Grid>
</UserControl>
