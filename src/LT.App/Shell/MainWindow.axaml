<controls:AppWindow
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Shell"
	xmlns:controls="using:LT.App.Controls"
	xmlns:connectionBar="using:LT.App.Widgets.ConnectionBar"
	xmlns:tradingPage="using:LT.App.Pages.TradingPage"
	xmlns:workspace="using:LT.App.Workspace"
	x:Class="LT.App.Shell.MainWindow"
	x:DataType="vm:MainWindowViewModel"
	Title="{Binding Title}"
	Width="1440"
	Height="900"
	MinWidth="1100"
	MinHeight="680"
	WindowStartupLocation="CenterScreen"
	Classes.flush="{Binding Appearance.IsFlush}"
>
	<!-- The app's title bar (AppWindow's template; the OS one is off). Everything lives under the
	     hamburger for now. -->
	<controls:AppWindow.TitleBarLeftContent>
		<Button Classes="tool" ToolTip.Tip="Menu">
			<PathIcon Data="M3,6H21V8H3Z M3,11H21V13H3Z M3,16H21V18H3Z" />
			<Button.Flyout>
				<MenuFlyout Placement="BottomEdgeAlignedLeft">
					<MenuItem Header="Log in…" Click="OnGatewayClick" />
					<MenuItem Header="Log out" Command="{Binding ConnectionBar.LogOutCommand}" />
					<Separator />
					<MenuItem Header="Refresh all" InputGesture="F5" Command="{Binding RefreshAllCommand}" />
					<MenuItem
						Header="New window"
						InputGesture="Ctrl+Shift+N"
						Command="{Binding NewWindowCommand}"
					/>
					<workspace:WidgetsMenuItem
						ToolClicked="OnToolClicked"
						FullscreenClicked="OnFullscreenClicked"
					/>
					<Separator />
					<MenuItem Header="Check for updates" Command="{Binding Update.CheckCommand}" />
					<MenuItem Header="Patch notes" Click="OnPatchNotesClick" />
					<MenuItem Header="Settings…" InputGesture="Ctrl+OemComma" Click="OnSettingsClick" />
					<Separator />
					<MenuItem Header="Exit" Click="OnExitClick" />
				</MenuFlyout>
			</Button.Flyout>
		</Button>
	</controls:AppWindow.TitleBarLeftContent>
	<controls:AppWindow.TitleBarRightContent>
		<StackPanel Orientation="Horizontal">
			<Button
				Classes="update"
				Margin="0,0,8,0"
				VerticalAlignment="Center"
				IsVisible="{Binding Update.IsVisible}"
				Content="{Binding Update.ButtonText}"
			>
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedRight">
						<StackPanel
							Width="320"
							Spacing="10"
							DataContext="{Binding Update}"
							x:DataType="vm:UpdateViewModel"
						>
							<TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding VersionsText}" />
							<HyperlinkButton
								Padding="0"
								Content="What's new"
								IsVisible="{Binding ReleasePageUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
								Click="OnReleaseNotesClick"
							/>
							<ProgressBar IsVisible="{Binding IsDownloading}" Value="{Binding Progress}" />
							<TextBlock
								Foreground="{DynamicResource NegativeBrush}"
								TextWrapping="Wrap"
								IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
								Text="{Binding ErrorText}"
							/>
							<TextBlock
								Classes="secondary"
								TextWrapping="Wrap"
								IsVisible="{Binding CannotInstallReason, Converter={x:Static ObjectConverters.IsNotNull}}"
								Text="{Binding CannotInstallReason}"
							/>
							<Button
								Classes="accent"
								HorizontalAlignment="Right"
								Content="Install and restart"
								Command="{Binding InstallCommand}"
							/>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>
			<!-- Privacy mode: account ids, balances, P&L and quantities show as dots everywhere -->
			<ToggleButton
				Classes="privacy"
				VerticalAlignment="Center"
				IsChecked="{Binding Privacy.IsSensitiveHidden}"
				ToolTip.Tip="Hide sensitive values (accounts, balances, P&amp;L, quantities)"
			>
				<Panel>
					<PathIcon
						Data="{StaticResource PrivacyShownIcon}"
						IsVisible="{Binding !Privacy.IsSensitiveHidden}"
					/>
					<PathIcon
						Data="{StaticResource PrivacyHiddenIcon}"
						IsVisible="{Binding Privacy.IsSensitiveHidden}"
					/>
				</Panel>
			</ToggleButton>
		</StackPanel>
	</controls:AppWindow.TitleBarRightContent>

	<Panel>
		<DockPanel>
			<Border
				DockPanel.Dock="Bottom"
				Padding="10,4"
				BorderBrush="{DynamicResource PanelStroke}"
				BorderThickness="0,1,0,0"
			>
				<DockPanel>
					<TextBlock DockPanel.Dock="Right" Classes="secondary" Text="{Binding ServerTimeText}" />
					<StackPanel Orientation="Horizontal" Spacing="16">
						<connectionBar:ConnectionBarView
							VerticalAlignment="Center"
							DataContext="{Binding ConnectionBar}"
						/>
						<controls:SensitiveTextBlock
							VerticalAlignment="Center"
							Classes="secondary"
							Text="{Binding AccountsText}"
						/>
						<TextBlock
							VerticalAlignment="Center"
							Classes="secondary"
							Text="{Binding MarketDataText}"
						/>
					</StackPanel>
				</DockPanel>
			</Border>

			<tradingPage:TradingPageView x:Name="Page" DataContext="{Binding CurrentPage}" />
		</DockPanel>
		<!-- Fullscreen widget (Ctrl+Shift+F): its frame moves here, over the workspace and status bar
		     (the title bar stays), and back on restore -->
		<Border
			x:Name="FullscreenLayer"
			Padding="8"
			Background="{DynamicResource SystemRegionBrush}"
			IsVisible="False"
		/>
	</Panel>
</controls:AppWindow>
