<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Shell"
	xmlns:connectionBar="using:LT.App.Widgets.ConnectionBar"
	xmlns:tradingPage="using:LT.App.Pages.TradingPage"
	x:Class="LT.App.Shell.MainWindow"
	x:DataType="vm:MainWindowViewModel"
	Title="{Binding Title}"
	Width="1440"
	Height="900"
	MinWidth="1000"
	MinHeight="640"
	WindowStartupLocation="CenterScreen"
>
	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="E_xit" Click="OnExitClick" />
			</MenuItem>
			<MenuItem Header="_View" />
			<MenuItem Header="_Trade" />
			<MenuItem Header="_Help" />
		</Menu>

		<Border
			DockPanel.Dock="Bottom"
			Padding="10,4"
			BorderBrush="{DynamicResource PanelStroke}"
			BorderThickness="0,1,0,0"
		>
			<DockPanel>
				<TextBlock DockPanel.Dock="Right" Classes="secondary" Text="{Binding ServerTimeText}" />
				<TextBlock Classes="secondary" Text="{Binding AccountsText}" />
			</DockPanel>
		</Border>

		<connectionBar:ConnectionBarView
			DockPanel.Dock="Top"
			Margin="8,8,8,0"
			DataContext="{Binding ConnectionBar}"
		/>

		<tradingPage:TradingPageView Margin="8" DataContext="{Binding CurrentPage}" />
	</DockPanel>
</Window>
