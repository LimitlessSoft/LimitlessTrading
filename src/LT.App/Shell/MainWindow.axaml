<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Shell"
	xmlns:connectionBar="using:LT.App.Widgets.ConnectionBar"
	xmlns:tradingPage="using:LT.App.Pages.TradingPage"
	xmlns:chrome="using:Avalonia.Controls.Chrome"
	x:Class="LT.App.Shell.MainWindow"
	x:DataType="vm:MainWindowViewModel"
	Title="{Binding Title}"
	Width="1440"
	Height="900"
	MinWidth="1100"
	MinHeight="680"
	WindowStartupLocation="CenterScreen"
	ExtendClientAreaToDecorationsHint="True"
	WindowDecorations="BorderOnly"
>
	<!-- No drawn border or shadow around the window: the app's own panels frame it -->
	<Window.WindowDecorationsTheme>
		<ControlTheme
			TargetType="chrome:WindowDrawnDecorations"
			BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}"
		>
			<Setter Property="DefaultFrameThickness" Value="0" />
			<Setter Property="DefaultShadowThickness" Value="0" />
		</ControlTheme>
	</Window.WindowDecorationsTheme>
	<Panel>
		<DockPanel>
			<!-- The app's title bar (the OS one is off): drag it to move the window, double-click to
			     maximize. Everything lives under the hamburger for now. -->
			<Border
				DockPanel.Dock="Top"
				Classes="toolbar"
				BorderBrush="{DynamicResource PanelStroke}"
				BorderThickness="0,0,0,1"
				chrome:WindowDecorationProperties.ElementRole="TitleBar"
			>
				<Grid ColumnDefinitions="Auto,*,Auto">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<!-- Role User: clicks reach the button instead of starting a window drag -->
						<Button
							Classes="tool"
							ToolTip.Tip="Menu"
							chrome:WindowDecorationProperties.ElementRole="User"
						>
							<PathIcon Data="M3,6H21V8H3Z M3,11H21V13H3Z M3,16H21V18H3Z" />
							<Button.Flyout>
								<MenuFlyout Placement="BottomEdgeAlignedLeft">
									<MenuItem Header="Log in…" Click="OnGatewayClick" />
									<MenuItem Header="Log out" Command="{Binding ConnectionBar.LogOutCommand}" />
									<Separator />
									<MenuItem Header="Find symbol" InputGesture="Ctrl+F" Click="OnFindClick" />
									<MenuItem
										Header="Refresh all"
										InputGesture="F5"
										Command="{Binding RefreshAllCommand}"
									/>
									<MenuItem Header="Widgets">
										<MenuItem
											Header="Watchlist"
											InputGesture="Ctrl+D1"
											Click="OnToolClick"
											Tag="Watchlist"
										/>
										<MenuItem
											Header="Positions"
											InputGesture="Ctrl+D2"
											Click="OnToolClick"
											Tag="Positions"
										/>
										<MenuItem
											Header="Orders"
											InputGesture="Ctrl+D3"
											Click="OnToolClick"
											Tag="Orders"
										/>
										<MenuItem
											Header="Executions"
											InputGesture="Ctrl+D4"
											Click="OnToolClick"
											Tag="Executions"
										/>
										<MenuItem
											Header="Account"
											InputGesture="Ctrl+D5"
											Click="OnToolClick"
											Tag="Account"
										/>
										<MenuItem
											Header="Messages"
											InputGesture="Ctrl+D6"
											Click="OnToolClick"
											Tag="Messages"
										/>
										<Separator />
										<MenuItem
											Header="Chart"
											InputGesture="Ctrl+D7"
											Click="OnToolClick"
											Tag="Chart"
										/>
										<MenuItem
											Header="Option chain"
											InputGesture="Ctrl+D8"
											Click="OnToolClick"
											Tag="OptionChain"
										/>
										<Separator />
										<MenuItem
											Header="New chart"
											InputGesture="Ctrl+Shift+D7"
											Click="OnNewChartClick"
										/>
										<MenuItem
											Header="Fullscreen widget"
											InputGesture="Ctrl+Shift+F"
											Click="OnFullscreenClick"
										/>
									</MenuItem>
									<Separator />
									<MenuItem
										Header="Settings…"
										InputGesture="Ctrl+OemComma"
										Click="OnSettingsClick"
									/>
									<Separator />
									<MenuItem Header="Exit" Click="OnExitClick" />
								</MenuFlyout>
							</Button.Flyout>
						</Button>
					</StackPanel>
					<TextBlock
						Grid.Column="1"
						Classes="secondary windowTitle"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Text="{Binding Title}"
						IsHitTestVisible="False"
					/>
					<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
						<Button
							Classes="windowButton"
							ToolTip.Tip="Minimize"
							chrome:WindowDecorationProperties.ElementRole="User"
							Click="OnMinimizeClick"
						>
							<PathIcon Data="{StaticResource WindowMinimizeIcon}" />
						</Button>
						<Button
							x:Name="MaximizeButton"
							Classes="windowButton"
							ToolTip.Tip="Maximize"
							chrome:WindowDecorationProperties.ElementRole="User"
							Click="OnMaximizeClick"
						>
							<PathIcon x:Name="MaximizeIcon" Data="{StaticResource WindowMaximizeIcon}" />
						</Button>
						<Button
							Classes="windowButton close"
							ToolTip.Tip="Close"
							chrome:WindowDecorationProperties.ElementRole="User"
							Click="OnCloseClick"
						>
							<PathIcon Data="{StaticResource FrameCloseIcon}" />
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<Border
				DockPanel.Dock="Bottom"
				Padding="10,4"
				BorderBrush="{DynamicResource PanelStroke}"
				BorderThickness="0,1,0,0"
			>
				<DockPanel>
					<TextBlock DockPanel.Dock="Right" Classes="secondary" Text="{Binding ServerTimeText}" />
					<StackPanel Orientation="Horizontal" Spacing="16">
						<connectionBar:ConnectionBarView
							VerticalAlignment="Center"
							DataContext="{Binding ConnectionBar}"
						/>
						<TextBlock
							VerticalAlignment="Center"
							Classes="secondary"
							Text="{Binding AccountsText}"
						/>
						<TextBlock
							VerticalAlignment="Center"
							Classes="secondary"
							Text="{Binding MarketDataText}"
						/>
					</StackPanel>
				</DockPanel>
			</Border>

			<tradingPage:TradingPageView x:Name="Page" DataContext="{Binding CurrentPage}" />
		</DockPanel>
		<!-- Fullscreen widget (Ctrl+Shift+F): its frame moves here, over the toolbar, workspace and
		     status bar, and back on restore -->
		<Border
			x:Name="FullscreenLayer"
			Padding="8"
			Background="{DynamicResource SystemRegionBrush}"
			IsVisible="False"
		/>
	</Panel>
</Window>
