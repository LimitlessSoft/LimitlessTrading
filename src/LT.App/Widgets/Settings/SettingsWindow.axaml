<controls:AppWindow
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Settings"
	xmlns:controls="using:LT.App.Controls"
	x:Class="LT.App.Widgets.Settings.SettingsWindow"
	x:DataType="vm:SettingsViewModel"
	Title="Settings"
	CanMinimize="False"
	Width="880"
	Height="580"
	MinWidth="680"
	MinHeight="420"
	WindowStartupLocation="CenterOwner"
>
	<Window.Styles>
		<Style Selector="StackPanel.setting">
			<Setter Property="Spacing" Value="4" />
		</Style>
		<Style Selector="TextBlock.settingHelp">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="MaxWidth" Value="560" />
			<Setter Property="HorizontalAlignment" Value="Left" />
		</Style>
	</Window.Styles>

	<Window.DataTemplates>
		<!-- One template per kind of setting -->
		<DataTemplate DataType="vm:BoolSettingViewModel">
			<StackPanel Classes="setting" IsVisible="{Binding IsVisible}">
				<CheckBox Content="{Binding Title}" IsChecked="{Binding Value}" />
				<TextBlock
					Classes="secondary settingHelp"
					Text="{Binding Description}"
					IsVisible="{Binding HasDescription}"
				/>
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:ChoiceSettingViewModel">
			<StackPanel Classes="setting" IsVisible="{Binding IsVisible}">
				<TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
				<ComboBox MinWidth="240" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
				<TextBlock
					Classes="secondary settingHelp"
					Text="{Binding Description}"
					IsVisible="{Binding HasDescription}"
				/>
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:NumberSettingViewModel">
			<StackPanel Classes="setting" IsVisible="{Binding IsVisible}">
				<TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
				<NumericUpDown
					Width="140"
					HorizontalAlignment="Left"
					FormatString="0"
					Increment="1"
					Minimum="{Binding Minimum}"
					Maximum="{Binding Maximum}"
					Value="{Binding Value}"
				/>
				<TextBlock
					Classes="secondary settingHelp"
					Text="{Binding Description}"
					IsVisible="{Binding HasDescription}"
				/>
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:TextSettingViewModel">
			<StackPanel Classes="setting" IsVisible="{Binding IsVisible}">
				<TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
				<TextBox
					Width="360"
					HorizontalAlignment="Left"
					PasswordChar="{Binding PasswordChar}"
					PlaceholderText="{Binding Placeholder}"
					Text="{Binding Value}"
				/>
				<TextBlock
					Classes="secondary settingHelp"
					Text="{Binding Description}"
					IsVisible="{Binding HasDescription}"
				/>
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:GuideSettingViewModel">
			<StackPanel Classes="setting" IsVisible="{Binding IsVisible}">
				<TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
				<ItemsControl ItemsSource="{Binding Steps}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="10" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="vm:GuideStepViewModel">
							<Grid ColumnDefinitions="24,*" MaxWidth="600" HorizontalAlignment="Left">
								<TextBlock FontWeight="SemiBold" Text="{Binding Number, StringFormat='{}{0}.'}" />
								<StackPanel Grid.Column="1" Spacing="4">
									<TextBlock TextWrapping="Wrap" Text="{Binding Text}" />
									<ItemsControl ItemsSource="{Binding Values}" IsVisible="{Binding HasValues}">
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="vm:GuideValueViewModel">
												<DockPanel Margin="0,1">
													<Button
														DockPanel.Dock="Right"
														Padding="8,1"
														Content="Copy"
														Click="OnCopyClick"
														ToolTip.Tip="{Binding Value}"
													/>
													<TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
														<Run
															Foreground="{DynamicResource SecondaryText}"
															Text="{Binding Label}"
														/>
														<Run Foreground="{DynamicResource SecondaryText}" Text=": " />
														<Run FontWeight="SemiBold" Text="{Binding Value}" />
													</TextBlock>
												</DockPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<Button
										HorizontalAlignment="Left"
										Content="{Binding LinkText}"
										Click="OnOpenLinkClick"
										IsVisible="{Binding HasLink}"
									/>
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:ActionSettingViewModel">
			<StackPanel Classes="setting" IsVisible="{Binding IsVisible}">
				<TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
				<StackPanel Orientation="Horizontal" Spacing="12">
					<TextBlock
						VerticalAlignment="Center"
						MaxWidth="460"
						TextWrapping="Wrap"
						Text="{Binding Status}"
					/>
					<Button
						VerticalAlignment="Top"
						Content="{Binding ButtonText}"
						Command="{Binding RunCommand}"
					/>
				</StackPanel>
				<ProgressBar
					Width="320"
					HorizontalAlignment="Left"
					IsIndeterminate="True"
					IsVisible="{Binding IsBusy}"
				/>
				<TextBlock
					Classes="secondary settingHelp"
					Text="{Binding Description}"
					IsVisible="{Binding HasDescription}"
				/>
			</StackPanel>
		</DataTemplate>
	</Window.DataTemplates>

	<DockPanel>
		<!-- Error and the dialog buttons -->
		<Border
			DockPanel.Dock="Bottom"
			Padding="16,10"
			BorderBrush="{DynamicResource PanelStroke}"
			BorderThickness="0,1,0,0"
		>
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
					<Button Content="Cancel" IsCancel="True" Click="OnCancelClick" />
					<Button Classes="accent" Content="Save" Click="OnSaveClick" />
				</StackPanel>
				<TextBlock
					VerticalAlignment="Center"
					Classes="negative"
					TextWrapping="Wrap"
					Text="{Binding ErrorMessage}"
					IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				/>
			</DockPanel>
		</Border>

		<Grid ColumnDefinitions="240,*">
			<!-- Left: search, then the tree of pages -->
			<Border
				Background="{DynamicResource PanelBackground}"
				BorderBrush="{DynamicResource PanelStroke}"
				BorderThickness="0,0,1,0"
			>
				<DockPanel>
					<TextBox
						x:Name="SearchBox"
						DockPanel.Dock="Top"
						Margin="10"
						Classes="clearButton"
						Watermark="Search settings"
						Text="{Binding SearchText}"
					/>
					<Panel>
						<TreeView
							Classes="settingsTree"
							ItemsSource="{Binding VisiblePages}"
							SelectedItem="{Binding SelectedNode}"
						>
							<TreeView.Styles>
								<Style Selector="TreeViewItem" x:DataType="vm:SettingsPageViewModel">
									<Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
								</Style>
							</TreeView.Styles>
							<TreeView.ItemTemplate>
								<TreeDataTemplate
									x:DataType="vm:SettingsPageViewModel"
									ItemsSource="{Binding VisibleChildren}"
								>
									<TextBlock Text="{Binding Title}" />
								</TreeDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
						<TextBlock
							Margin="12,4"
							Classes="secondary"
							TextWrapping="Wrap"
							Text="No settings match."
							IsVisible="{Binding HasNoResults}"
						/>
					</Panel>
				</DockPanel>
			</Border>

			<!-- Right: the page, its tabs (when it has several) and their settings -->
			<Panel Grid.Column="1" IsVisible="{Binding HasPage}">
				<DockPanel
					Margin="20,14,20,0"
					DataContext="{Binding SelectedPage}"
					x:DataType="vm:SettingsPageViewModel"
				>
					<TextBlock
						DockPanel.Dock="Top"
						Margin="0,0,0,8"
						FontSize="18"
						FontWeight="SemiBold"
						Text="{Binding Path}"
					/>
					<TabStrip
						DockPanel.Dock="Top"
						Margin="0,0,0,12"
						ItemsSource="{Binding VisibleTabs}"
						SelectedItem="{Binding SelectedTab}"
						IsVisible="{Binding HasTabStrip}"
					>
						<TabStrip.ItemTemplate>
							<DataTemplate x:DataType="vm:SettingsTabViewModel">
								<TextBlock Text="{Binding Title}" />
							</DataTemplate>
						</TabStrip.ItemTemplate>
					</TabStrip>
					<ScrollViewer>
						<ItemsControl
							Margin="0,0,0,16"
							ItemsSource="{Binding SelectedTab.Items, FallbackValue={x:Null}}"
						>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Spacing="18" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</ScrollViewer>
				</DockPanel>
			</Panel>
		</Grid>
	</DockPanel>
</controls:AppWindow>
