<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Chart"
	x:Class="LT.App.Widgets.Chart.ChartTitleView"
	x:DataType="vm:ChartViewModel"
>
	<!-- Chart header title: click it to type a ticker (IB listings are suggested) or pick a recent one -->
	<Panel>
		<Button
			x:Name="TitleButton"
			Classes="chartTitle"
			Content="{Binding Title}"
			ToolTip.Tip="Click to change the ticker"
		/>
		<StackPanel x:Name="Editor" Orientation="Horizontal" Spacing="2" IsVisible="False">
			<AutoCompleteBox
				x:Name="TickerBox"
				Classes="ticker"
				PlaceholderText="Ticker, e.g. AAPL"
				Width="360"
				MinimumPrefixLength="0"
				MinimumPopulateDelay="0:0:0.35"
				FilterMode="None"
				MaxDropDownHeight="320"
			>
				<AutoCompleteBox.ItemTemplate>
					<DataTemplate x:DataType="vm:ContractSuggestionItem">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock FontWeight="SemiBold" Text="{Binding Symbol}" />
							<TextBlock Classes="secondary" Text="{Binding Description}" />
						</StackPanel>
					</DataTemplate>
				</AutoCompleteBox.ItemTemplate>
			</AutoCompleteBox>
			<Button x:Name="RecentButton" Classes="frameAction" ToolTip.Tip="Recent tickers">
				<PathIcon Data="{StaticResource ChevronDownIcon}" />
			</Button>
		</StackPanel>
	</Panel>
</UserControl>
