<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Chart"
	x:Class="LT.App.Widgets.Chart.ChartTitleView"
	x:DataType="vm:ChartViewModel"
>
	<!-- Chart header title: click it to type a ticker or pick a recent one -->
	<Panel>
		<Button
			x:Name="TitleButton"
			Classes="chartTitle"
			Content="{Binding Title}"
			ToolTip.Tip="Click to change the ticker"
		/>
		<StackPanel x:Name="Editor" Orientation="Horizontal" Spacing="2" IsVisible="False">
			<AutoCompleteBox
				x:Name="TickerBox"
				Classes="ticker"
				Width="180"
				PlaceholderText="Ticker, e.g. AAPL"
				MinimumPrefixLength="0"
				FilterMode="StartsWith"
				MaxDropDownHeight="320"
				ItemsSource="{Binding RecentContracts}"
			>
				<AutoCompleteBox.ItemTemplate>
					<DataTemplate x:DataType="vm:RecentContractItem">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock FontWeight="SemiBold" Text="{Binding Symbol}" />
							<TextBlock Classes="secondary" Text="{Binding Description}" />
						</StackPanel>
					</DataTemplate>
				</AutoCompleteBox.ItemTemplate>
			</AutoCompleteBox>
			<Button x:Name="RecentButton" Classes="frameAction" ToolTip.Tip="Recent tickers">
				<PathIcon Data="{StaticResource ChevronDownIcon}" />
			</Button>
		</StackPanel>
	</Panel>
</UserControl>
