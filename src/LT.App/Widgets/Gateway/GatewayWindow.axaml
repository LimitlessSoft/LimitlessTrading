<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Gateway"
	x:Class="LT.App.Widgets.Gateway.GatewayWindow"
	x:DataType="vm:GatewayViewModel"
	Title="Log in — IB Gateway"
	Width="480"
	SizeToContent="Height"
	CanResize="False"
	WindowStartupLocation="CenterOwner"
>
	<StackPanel Margin="20" Spacing="14">
		<TextBlock
			Classes="secondary"
			TextWrapping="Wrap"
			Text="LimitlessTrading starts IB Gateway and connects to it once you have logged in. Log in in Gateway's own window: username, password, live or paper, and IB Key approval on your phone. None of that goes through this app."
		/>
		<TextBlock
			Classes="secondary"
			TextWrapping="Wrap"
			Text="First time only, in Gateway: Configure → Settings → API → Settings — keep the socket port at 4001 (live) / 4002 (paper) and untick Read-Only API to trade from this app."
		/>

		<Expander
			Header="Install"
			HorizontalAlignment="Stretch"
			IsExpanded="{Binding !IsGatewayFound, Mode=OneWay}"
		>
			<StackPanel Spacing="8">
				<Grid
					ColumnDefinitions="Auto,*,Auto"
					RowDefinitions="Auto,Auto"
					ColumnSpacing="8"
					RowSpacing="8"
				>
					<TextBlock
						Grid.Row="0"
						VerticalAlignment="Center"
						Classes="secondary"
						Text="Gateway folder"
					/>
					<TextBox
						Grid.Row="0"
						Grid.Column="1"
						Text="{Binding GatewayPath}"
						IsEnabled="{Binding CanEdit}"
					/>
					<Button
						Grid.Row="0"
						Grid.Column="2"
						Content="Browse…"
						Click="OnBrowseGatewayClick"
						IsEnabled="{Binding CanEdit}"
					/>

					<TextBlock Grid.Row="1" VerticalAlignment="Center" Classes="secondary" Text="Version" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Width="90"
						HorizontalAlignment="Left"
						Text="{Binding GatewayVersion}"
						IsEnabled="{Binding CanEdit}"
					/>
				</Grid>

				<TextBlock
					TextWrapping="Wrap"
					Classes="secondary"
					Classes.positive="{Binding IsGatewayFound}"
					Classes.negative="{Binding !IsGatewayFound}"
					Text="{Binding GatewayStatusText}"
				/>
				<TextBlock
					Classes="negative"
					TextWrapping="Wrap"
					Text="{Binding InstallError}"
					IsVisible="{Binding InstallError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				/>

				<Button HorizontalAlignment="Right" Content="Locate" Command="{Binding LocateCommand}" />
			</StackPanel>
		</Expander>

		<StackPanel Orientation="Horizontal" Spacing="8">
			<Ellipse
				Classes="status"
				VerticalAlignment="Center"
				Classes.connected="{Binding IsRunning}"
				Classes.connecting="{Binding IsBusy}"
				Classes.failed="{Binding IsFailed}"
			/>
			<TextBlock VerticalAlignment="Center" Text="{Binding StateText}" />
		</StackPanel>
		<TextBlock
			Classes="negative"
			TextWrapping="Wrap"
			Text="{Binding ErrorMessage}"
			IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
		/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Content="Close" IsCancel="True" Click="OnCloseClick" />
			<Button Content="{Binding StopText}" Command="{Binding StopCommand}" />
			<Button
				Classes="accent"
				Content="Start IB Gateway"
				IsDefault="True"
				Command="{Binding StartCommand}"
			/>
		</StackPanel>
	</StackPanel>
</Window>
