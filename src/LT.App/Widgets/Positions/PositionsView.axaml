<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Positions"
	xmlns:dto="using:LT.Contracts.Dtos.Positions"
	x:Class="LT.App.Widgets.Positions.PositionsView"
	x:DataType="vm:PositionsViewModel"
>
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
			<Button Content="Refresh" Command="{Binding RefreshCommand}" />
			<TextBlock
				VerticalAlignment="Center"
				Classes="secondary"
				Text="Connect to TWS / IB Gateway to load positions."
				IsVisible="{Binding !IsConnected}"
			/>
			<TextBlock
				VerticalAlignment="Center"
				Classes="negative"
				Text="{Binding ErrorMessage}"
				IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			/>
		</StackPanel>
		<DataGrid
			ItemsSource="{Binding Positions}"
			IsReadOnly="True"
			CanUserSortColumns="True"
			GridLinesVisibility="Horizontal"
		>
			<DataGrid.Columns>
				<DataGridTextColumn
					x:DataType="dto:PositionDto"
					Header="Account"
					Binding="{Binding Account}"
				/>
				<DataGridTextColumn
					x:DataType="dto:PositionDto"
					Header="Symbol"
					Binding="{Binding Symbol}"
				/>
				<DataGridTextColumn
					x:DataType="dto:PositionDto"
					Header="Type"
					Binding="{Binding SecurityType}"
				/>
				<DataGridTextColumn
					x:DataType="dto:PositionDto"
					Header="Exchange"
					Binding="{Binding Exchange}"
				/>
				<DataGridTextColumn
					x:DataType="dto:PositionDto"
					Header="Currency"
					Binding="{Binding Currency}"
				/>
				<DataGridTextColumn
					x:DataType="dto:PositionDto"
					Header="Quantity"
					Binding="{Binding Quantity, StringFormat='{}{0:#,0.####}'}"
				/>
				<DataGridTextColumn
					x:DataType="dto:PositionDto"
					Header="Avg cost"
					Binding="{Binding AverageCost, StringFormat='{}{0:#,0.00##}'}"
				/>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
