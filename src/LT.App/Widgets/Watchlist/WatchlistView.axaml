<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Watchlist"
	xmlns:controls="using:LT.App.Controls"
	x:Class="LT.App.Widgets.Watchlist.WatchlistView"
	x:DataType="vm:WatchlistViewModel"
>
	<DockPanel>
		<!-- Typing lists IB's listings of the symbol; pick one or press Enter to add it -->
		<controls:ContractSearchBox
			x:Name="SearchBox"
			DockPanel.Dock="Top"
			Margin="0,0,0,6"
			Placeholder="Add symbol (Ctrl+F)"
		/>

		<TextBlock
			DockPanel.Dock="Top"
			Classes="negative"
			FontSize="12"
			TextWrapping="Wrap"
			Margin="0,0,0,6"
			Text="{Binding ErrorMessage}"
			IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
		/>

		<DataGrid
			ItemsSource="{Binding Rows}"
			SelectedItem="{Binding SelectedRow}"
			IsReadOnly="True"
			CanUserSortColumns="True"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
			KeyDown="OnGridKeyDown"
		>
			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Remove from watchlist" Command="{Binding RemoveCommand}" />
				</ContextMenu>
			</DataGrid.ContextMenu>
			<DataGrid.Columns>
				<DataGridTemplateColumn Header="Symbol" Width="*" MinWidth="130" SortMemberPath="Symbol">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<StackPanel Margin="8,2" VerticalAlignment="Center">
								<StackPanel Orientation="Horizontal" Spacing="4">
									<TextBlock FontWeight="SemiBold" Text="{Binding Symbol}" />
									<TextBlock
										Classes="warning"
										FontSize="10"
										Text="D"
										VerticalAlignment="Center"
										IsVisible="{Binding IsDelayed}"
										ToolTip.Tip="Delayed data"
									/>
									<!-- Quote errors: the message is on hover, so the row keeps its height -->
									<PathIcon
										Width="12"
										Height="12"
										VerticalAlignment="Center"
										Background="Transparent"
										Foreground="{DynamicResource NegativeBrush}"
										Data="{StaticResource ErrorIcon}"
										IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
										ToolTip.Tip="{Binding Error}"
									/>
								</StackPanel>
								<TextBlock Classes="secondary" FontSize="10" Text="{Binding Description}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="Last" Width="Auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<TextBlock
								Classes="value"
								Margin="8,0"
								VerticalAlignment="Center"
								Text="{Binding Last}"
							/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="Chg %" Width="Auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<StackPanel Margin="8,0" VerticalAlignment="Center">
								<TextBlock
									Classes="value"
									Classes.positive="{Binding IsUp}"
									Classes.negative="{Binding IsDown}"
									Text="{Binding ChangePercent}"
								/>
								<TextBlock
									Classes="value secondary"
									FontSize="10"
									Classes.positive="{Binding IsUp}"
									Classes.negative="{Binding IsDown}"
									Text="{Binding Change}"
								/>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="Bid / Ask" Width="Auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<StackPanel Margin="8,0" VerticalAlignment="Center">
								<TextBlock Classes="value" FontSize="12" Text="{Binding Bid}" />
								<TextBlock Classes="value" FontSize="12" Text="{Binding Ask}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="Vol" Width="Auto">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<TextBlock
								Classes="value secondary"
								Margin="8,0"
								VerticalAlignment="Center"
								Text="{Binding Volume}"
							/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
