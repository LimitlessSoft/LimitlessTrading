<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Pages.TradingPage"
	xmlns:workspace="using:LT.App.Workspace"
	x:Class="LT.App.Pages.TradingPage.TradingPageView"
	x:DataType="vm:TradingPageViewModel"
>
	<workspace:WorkspaceView x:Name="Workspace" DataContext="{Binding Workspace}" />
</UserControl>
