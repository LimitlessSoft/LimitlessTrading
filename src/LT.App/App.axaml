<Application
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:chrome="using:Avalonia.Controls.Chrome"
	xmlns:controls="using:LT.App.Controls"
	x:Class="LT.App.App"
	RequestedThemeVariant="Dark"
>
	<Application.Resources>
		<SolidColorBrush x:Key="PanelBackground" Color="#1B1E24" />
		<SolidColorBrush x:Key="PanelStroke" Color="#2C313A" />
		<SolidColorBrush x:Key="SecondaryText" Color="#8A93A3" />
		<SolidColorBrush x:Key="PositiveBrush" Color="#26A69A" />
		<SolidColorBrush x:Key="NegativeBrush" Color="#EF5350" />
		<SolidColorBrush x:Key="WarningBrush" Color="#FFB74D" />
		<!-- Option chain strikes by σ distance from the price: accent blue fading toward the panel -->
		<SolidColorBrush x:Key="SigmaOneBrush" Color="#2E4566" />
		<SolidColorBrush x:Key="SigmaTwoBrush" Color="#283850" />
		<SolidColorBrush x:Key="SigmaThreeBrush" Color="#222B3A" />
		<SolidColorBrush x:Key="SigmaBeyondBrush" Color="#1E2229" />
		<!-- Option chain sides: a faint green (calls) / red (puts) under every cell, stronger in
		     the money; translucent, so the text and the row selection read through -->
		<SolidColorBrush x:Key="CallSideBrush" Color="#1026A69A" />
		<SolidColorBrush x:Key="CallItmBrush" Color="#3026A69A" />
		<SolidColorBrush x:Key="PutSideBrush" Color="#10EF5350" />
		<SolidColorBrush x:Key="PutItmBrush" Color="#30EF5350" />
		<!-- Option chain one-click cells: translucent, so they tint the ITM shade underneath -->
		<SolidColorBrush x:Key="BuyHoverBrush" Color="#4026A69A" />
		<SolidColorBrush x:Key="BuyPressedBrush" Color="#7026A69A" />
		<SolidColorBrush x:Key="SellHoverBrush" Color="#40EF5350" />
		<SolidColorBrush x:Key="SellPressedBrush" Color="#70EF5350" />
		<!-- Calendar earnings row whose reported EPS just came in: the warning amber, translucent -->
		<SolidColorBrush x:Key="FreshResultBrush" Color="#33FFB74D" />

		<!-- Error badge (e.g. a watchlist row whose quotes failed), on a 12×12 grid -->
		<StreamGeometry x:Key="ErrorIcon">
			F0 M6,0 A6,6 0 1 1 6,12 A6,6 0 1 1 6,0 Z M5.25,2.5 H6.75 V7.25 H5.25 Z M5.25,8.5 H6.75 V10 H5.25 Z
		</StreamGeometry>
		<!-- Widget frame header actions, drawn on a 12×12 grid -->
		<StreamGeometry x:Key="FrameCloseIcon">
			M2.2,1.1 L6,4.9 L9.8,1.1 L10.9,2.2 L7.1,6 L10.9,9.8 L9.8,10.9 L6,7.1 L2.2,10.9 L1.1,9.8 L4.9,6 L1.1,2.2 Z
		</StreamGeometry>
		<!-- Window buttons in the app's own title bar, on a 12×12 grid (close reuses FrameCloseIcon) -->
		<StreamGeometry x:Key="WindowMinimizeIcon">M1,5.4 H11 V6.6 H1 Z</StreamGeometry>
		<StreamGeometry x:Key="WindowMaximizeIcon">
			M1,1 H11 V11 H1 Z M2.2,2.2 V9.8 H9.8 V2.2 Z
		</StreamGeometry>
		<StreamGeometry x:Key="WindowRestoreIcon">
			M3,1 H11 V9 H9 V7.8 H9.8 V2.2 H4.2 V3 H3 Z M1,3 H9 V11 H1 Z M2.2,4.2 V9.8 H7.8 V4.2 Z
		</StreamGeometry>
		<!-- Material Design "pin" (Apache-2.0), on a 24×24 grid -->
		<StreamGeometry x:Key="FramePinIcon">
			M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z
		</StreamGeometry>
		<!-- Material Design "pencil" (Apache-2.0), on a 24×24 grid -->
		<StreamGeometry x:Key="FrameRenameIcon">
			M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z
		</StreamGeometry>
		<!-- Four corners pointing out (fullscreen) / in (restore) -->
		<StreamGeometry x:Key="FrameFullscreenIcon">
			M1,1 H5 V2.5 H2.5 V5 H1 Z M7,1 H11 V5 H9.5 V2.5 H7 Z M1,7 H2.5 V9.5 H5 V11 H1 Z M11,7 V11 H7 V9.5 H9.5 V7 Z
		</StreamGeometry>
		<StreamGeometry x:Key="FrameRestoreIcon">
			M3.5,1 H5 V5 H1 V3.5 H3.5 Z M7,1 H8.5 V3.5 H11 V5 H7 Z M1,7 H5 V11 H3.5 V8.5 H1 Z M7,7 H11 V8.5 H8.5 V11 H7 Z
		</StreamGeometry>
		<StreamGeometry x:Key="ChevronDownIcon">
			M1.6,3.6 L6,8 L10.4,3.6 L11.4,4.6 L6,10 L0.6,4.6 Z
		</StreamGeometry>
		<!-- Material Design "link" (Apache-2.0), on a 24×24 grid -->
		<StreamGeometry x:Key="FrameLinkIcon">
			M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z
		</StreamGeometry>
		<!-- Center view tab strip: add a view -->
		<StreamGeometry x:Key="ViewAddIcon">
			M5.3,1 H6.7 V5.3 H11 V6.7 H6.7 V11 H5.3 V6.7 H1 V5.3 H5.3 Z
		</StreamGeometry>
		<!-- Material Design "logout" (Apache-2.0), on a 24×24 grid: close a position -->
		<StreamGeometry x:Key="ClosePositionIcon">
			M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z
		</StreamGeometry>
		<!-- Material Design "flash" (Apache-2.0), on a 24×24 grid: quick exit at market -->
		<StreamGeometry x:Key="QuickExitIcon">M7,2V13H10V22L17,10H13L17,2H7Z</StreamGeometry>
		<!-- Privacy mode in the title bar: Material Design "eye" / "eye-off" (Apache-2.0), 24×24 -->
		<StreamGeometry x:Key="PrivacyShownIcon">
			M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z
		</StreamGeometry>
		<StreamGeometry x:Key="PrivacyHiddenIcon">
			M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.74,7.13 11.35,7 12,7Z
		</StreamGeometry>
		<SolidColorBrush x:Key="FrameActionHoverBrush" Color="#2C323C" />
		<SolidColorBrush x:Key="CurrentFrameBrush" Color="#7FA7E8" Opacity="0.55" />
		<SolidColorBrush x:Key="FrameCloseHoverBrush" Color="#3A2326" />

		<!-- Flush layout: a splitter is a 7px grab area over its neighbours with a 1px line in the
		     middle (stops at 3/7 and 4/7) -->
		<LinearGradientBrush x:Key="FlushSplitterColumnBrush" StartPoint="0%,50%" EndPoint="100%,50%">
			<GradientStop Offset="0.4285" Color="Transparent" />
			<GradientStop Offset="0.4285" Color="#2C313A" />
			<GradientStop Offset="0.5714" Color="#2C313A" />
			<GradientStop Offset="0.5714" Color="Transparent" />
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="FlushSplitterRowBrush" StartPoint="50%,0%" EndPoint="50%,100%">
			<GradientStop Offset="0.4285" Color="Transparent" />
			<GradientStop Offset="0.4285" Color="#2C313A" />
			<GradientStop Offset="0.5714" Color="#2C313A" />
			<GradientStop Offset="0.5714" Color="Transparent" />
		</LinearGradientBrush>

		<StreamGeometry x:Key="ChevronUpIcon">
			M1.6,8.4 L6,4 L10.4,8.4 L11.4,7.4 L6,2 L0.6,7.4 Z
		</StreamGeometry>
		<!-- NumericUpDown.compact's spinner: Fluent's ButtonSpinner sizes its buttons in the template
		     (MinWidth 34, bordered), which styles can't override, so it gets its own slim template:
		     two flat 18px chevron buttons that light up on hover -->
		<ControlTheme x:Key="CompactSpinnerButton" TargetType="RepeatButton">
			<Setter Property="Width" Value="18" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<ControlTemplate>
					<ContentPresenter
						Name="PART_ContentPresenter"
						Background="{TemplateBinding Background}"
						Foreground="{TemplateBinding Foreground}"
						Content="{TemplateBinding Content}"
						Padding="{TemplateBinding Padding}"
						HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
						VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
					/>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
				<Setter Property="Foreground" Value="White" />
			</Style>
			<Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource PanelStroke}" />
			</Style>
			<Style Selector="^:disabled">
				<Setter Property="Opacity" Value="0.35" />
			</Style>
		</ControlTheme>
		<ControlTheme x:Key="CompactButtonSpinner" TargetType="ButtonSpinner">
			<Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
			<Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
			<Setter
				Property="BorderThickness"
				Value="{DynamicResource TextControlBorderThemeThickness}"
			/>
			<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Focusable" Value="True" />
			<Setter Property="Template">
				<ControlTemplate>
					<DataValidationErrors>
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}"
						>
							<DockPanel>
								<StackPanel
									Name="PART_SpinnerPanel"
									TabIndex="2"
									DockPanel.Dock="Right"
									Orientation="Horizontal"
									IsVisible="{TemplateBinding ShowButtonSpinner}"
								>
									<RepeatButton
										Name="PART_DecreaseButton"
										Theme="{StaticResource CompactSpinnerButton}"
										IsTabStop="False"
									>
										<PathIcon Width="8" Height="8" Data="{StaticResource ChevronDownIcon}" />
									</RepeatButton>
									<RepeatButton
										Name="PART_IncreaseButton"
										Theme="{StaticResource CompactSpinnerButton}"
										IsTabStop="False"
									>
										<PathIcon Width="8" Height="8" Data="{StaticResource ChevronUpIcon}" />
									</RepeatButton>
								</StackPanel>
								<ContentPresenter
									Name="PART_ContentPresenter"
									TabIndex="1"
									ContentTemplate="{TemplateBinding ContentTemplate}"
									Content="{TemplateBinding Content}"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									Padding="{TemplateBinding Padding}"
								/>
							</DockPanel>
						</Border>
					</DataValidationErrors>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:error">
				<Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
			</Style>
		</ControlTheme>

		<!-- AppWindow: no drawn border or shadow, the app's own panels frame them -->
		<ControlTheme
			x:Key="AppWindowDecorations"
			TargetType="chrome:WindowDrawnDecorations"
			BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}"
		>
			<Setter Property="DefaultFrameThickness" Value="0" />
			<Setter Property="DefaultShadowThickness" Value="0" />
		</ControlTheme>

		<!-- Every window (AppWindow and its subclasses): the OS title bar is off
		     (ExtendClientAreaToDecorationsHint + BorderOnly, Avalonia's client-side decorations
		     without frame or shadow) and the app's WindowTitleBar sits above the content. The
		     template is Fluent's Window template with the bar added; Padding pads the content only. -->
		<ControlTheme
			x:Key="{x:Type controls:AppWindow}"
			TargetType="controls:AppWindow"
			BasedOn="{StaticResource {x:Type Window}}"
		>
			<Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
			<Setter Property="WindowDecorations" Value="BorderOnly" />
			<Setter Property="WindowDecorationsTheme" Value="{StaticResource AppWindowDecorations}" />
			<Setter Property="Template">
				<ControlTemplate>
					<Panel>
						<Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
						<Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
						<Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
						<VisualLayerManager Name="PART_VisualLayerManager">
							<!-- The UI scale: bar and content, inside the layer manager so overlay
							     popups (which inherit their target's scale) aren't scaled twice -->
							<controls:UiScaleHost>
								<DockPanel>
									<controls:WindowTitleBar
										Name="PART_TitleBar"
										DockPanel.Dock="Top"
										Title="{TemplateBinding Title}"
										LeftContent="{TemplateBinding TitleBarLeftContent}"
										RightContent="{TemplateBinding TitleBarRightContent}"
									/>
									<ContentPresenter
										Name="PART_ContentPresenter"
										ContentTemplate="{TemplateBinding ContentTemplate}"
										Content="{TemplateBinding Content}"
										Margin="{TemplateBinding Padding}"
										HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									/>
								</DockPanel>
							</controls:UiScaleHost>
						</VisualLayerManager>
					</Panel>
				</ControlTemplate>
			</Setter>
		</ControlTheme>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

		<!-- The UI scale reaches popups (menus, flyouts, tooltips, drop-downs; separate windows on
		     desktop): each takes its placement target's scale, which comes from the window's
		     UiScaleHost -->
		<Style Selector="Popup">
			<Setter Property="InheritsTransform" Value="True" />
		</Style>

		<!-- App icon on every window (taskbar, Alt+Tab) -->
		<Style Selector=":is(Window)">
			<Setter Property="Icon" Value="avares://LimitlessTrading/Assets/limitlesstrading.ico" />
		</Style>

		<Style Selector="Border.panel">
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10" />
		</Style>
		<Style Selector="Border.panel.docked">
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<!-- The current widget (last clicked or typed in): a light frame. Docked side widgets have no
		     border, so they get one here with 1px less padding to keep content put. -->
		<Style Selector="Border.panel.current">
			<Setter Property="BorderBrush" Value="{DynamicResource CurrentFrameBrush}" />
		</Style>
		<Style Selector="Border.panel.docked.current">
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="9" />
		</Style>
		<!-- Flush layout (Settings → Appearance): every widget gets the docked look, square and
		     borderless, filling its cell; the current one keeps its light frame -->
		<Style Selector=":is(Window).flush Border.panel">
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector=":is(Window).flush Border.panel.current">
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="9" />
		</Style>
		<!-- Fullscreen widget: an orange frame says you're not looking at the normal layout.
		     After .docked so it wins for side widgets too; 1px less padding keeps content put. -->
		<Style Selector="Border.panel.fullscreen">
			<Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="9" />
		</Style>
		<Style Selector=":is(Window).flush Border.panel.fullscreen">
			<Setter Property="CornerRadius" Value="0" />
		</Style>
		<Style Selector="TextBlock.panelTitle">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.secondary">
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="TextBlock.value">
			<Setter Property="FontFeatures" Value="tnum" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>
		<Style Selector="Border.strip">
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
			<Setter Property="Padding" Value="4,8" />
		</Style>
		<!-- The bottom strip lays its icons out in a row -->
		<Style Selector="Border.strip.horizontal">
			<Setter Property="Padding" Value="8,4" />
		</Style>
		<Style Selector="Border.toolbar">
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="Padding" Value="4,4,4,0" />
		</Style>
		<!-- Title bar window buttons: flat, full toolbar height; close turns red on hover -->
		<Style Selector="Button.windowButton">
			<Setter Property="Width" Value="46" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.windowButton PathIcon">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="10" />
		</Style>
		<Style Selector="Button.windowButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.windowButton.close:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#C42B1C" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<!-- Title bar privacy switch (an eye left of the window buttons): flat like them, lit while
		     sensitive values are hidden -->
		<Style Selector="ToggleButton.privacy">
			<Setter Property="Width" Value="40" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="ToggleButton.privacy PathIcon">
			<Setter Property="Width" Value="16" />
			<Setter Property="Height" Value="16" />
		</Style>
		<Style Selector="ToggleButton.privacy:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
		</Style>
		<Style Selector="ToggleButton.privacy:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<!-- Title bar "Update x.y.z": a small accent pill left of the window buttons -->
		<Style Selector="Button.update">
			<Setter Property="Height" Value="24" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.update:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.tool">
			<Setter Property="Width" Value="36" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0,0,0,4" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
		</Style>
		<Style Selector="Button.tool PathIcon">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
		</Style>
		<!-- Bottom strip icons sit in a row, so the gap goes to the right instead of below.
		     Must follow Button.tool: Avalonia lets the later style win, not the more specific. -->
		<Style Selector="Border.strip.horizontal Button.tool">
			<Setter Property="Margin" Value="0,0,4,0" />
		</Style>
		<Style Selector="Button.tool.active">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.tool.active:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<!-- Center view tabs: quiet until hovered; the shown one is lit and underlined -->
		<Style Selector="Border.viewTabs">
			<Setter Property="Padding" Value="0,6,0,0" />
		</Style>
		<Style Selector=":is(Window).flush Border.viewTabs">
			<Setter Property="Padding" Value="4,4,4,0" />
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
			<Setter Property="BorderThickness" Value="0,0,0,1" />
		</Style>
		<Style Selector="Border.viewTab">
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="12,0,6,0" />
			<Setter Property="CornerRadius" Value="6,6,0,0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0,0,0,2" />
			<Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryText}" />
		</Style>
		<Style Selector="Border.viewTab:pointerover">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<Style Selector="Border.viewTab.selected">
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="TextElement.Foreground" Value="White" />
		</Style>
		<Style Selector="Border.viewTab TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Margin" Value="0,0,6,0" />
		</Style>
		<Style Selector="TextBox.viewName">
			<Setter Property="MinHeight" Value="24" />
			<Setter Property="MinWidth" Value="100" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Padding" Value="6,2" />
			<Setter Property="Margin" Value="0,0,6,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.frameAction.viewClose">
			<Setter Property="Width" Value="20" />
			<Setter Property="Height" Value="20" />
		</Style>
		<Style Selector="Button.frameAction.viewAdd">
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="28" />
			<Setter Property="Margin" Value="4,0,0,0" />
		</Style>
		<Style Selector="Border.dropTarget">
			<Setter Property="Background" Value="#332F7BF6" />
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<!-- Widget frame header actions: quiet until the frame is hovered, close turns red -->
		<Style Selector="StackPanel.frameActions">
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="UserControl:pointerover StackPanel.frameActions">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<!-- Ticker header title (chart, option chain): reads as the title, hints it can be clicked -->
		<Style Selector="Button.tickerTitle">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,1" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="Button.tickerTitle:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<!-- Chart header timeframe beside the title: quieter than the title, same hover hint -->
		<Style Selector="Button.chartTimeframe">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,1" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
		</Style>
		<Style Selector="Button.chartTimeframe:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<!-- Watchlist header: the picker reads as the title; its rows are flat full-width buttons -->
		<Style Selector="Button.watchlistPicker">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,1" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="Button.watchlistPicker:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<Style Selector="Button.pickerRow">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="Button.pickerRow:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<Style Selector="Button.pickerRow.active">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource SystemAccentColorLight2}" />
		</Style>
		<Style Selector="TextBox.watchlistName">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="FontSize" Value="13" />
		</Style>
		<!-- Confirms something that can't be undone (e.g. deleting a watchlist) -->
		<Style Selector="Button.danger">
			<Setter Property="Background" Value="#C42B1C" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<!-- Compact number box for a header or status row (option chain "Qty"): 24px like the frame
		     actions, text centred, the slim CompactButtonSpinner. Fluent's TextBox minimum height
		     sits on the inner text box too, so it is reset there as well. -->
		<Style Selector="NumericUpDown.compact">
			<Setter Property="Height" Value="24" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="NumericUpDown.compact /template/ ButtonSpinner#PART_Spinner">
			<Setter Property="Theme" Value="{StaticResource CompactButtonSpinner}" />
		</Style>
		<Style Selector="NumericUpDown.compact /template/ TextBox#PART_TextBox">
			<Setter Property="MinHeight" Value="0" />
		</Style>
		<Style Selector="AutoCompleteBox.ticker">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="Button.frameAction">
			<Setter Property="Width" Value="24" />
			<Setter Property="Height" Value="24" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="5" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.frameAction PathIcon">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="10" />
		</Style>
		<Style Selector="Button.frameAction.pin PathIcon">
			<Setter Property="Width" Value="12" />
			<Setter Property="Height" Value="12" />
		</Style>
		<!-- Unpinned: the pin tilts and dims -->
		<Style Selector="Button.frameAction.pin.unpinned PathIcon">
			<Setter Property="Opacity" Value="0.6" />
			<Setter Property="RenderTransform" Value="rotate(45deg)" />
		</Style>
		<Style Selector="Button.frameAction.link PathIcon">
			<Setter Property="Width" Value="14" />
			<Setter Property="Height" Value="14" />
		</Style>
		<Style Selector="Button.frameAction.closePosition PathIcon">
			<Setter Property="Width" Value="14" />
			<Setter Property="Height" Value="14" />
		</Style>
		<Style Selector="Button.frameAction:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.frameAction:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource PanelStroke}" />
		</Style>
		<Style Selector="Button.frameAction.close:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameCloseHoverBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
		</Style>
		<Style Selector="Button.statusItem">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,1" />
			<Setter Property="MinHeight" Value="0" />
		</Style>
		<!-- A picker in the status bar (UI scale): as slim as the other status items -->
		<Style Selector="ComboBox.statusItem">
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Padding" Value="6,0,0,0" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Ellipse.status">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="10" />
			<Setter Property="Fill" Value="{DynamicResource SecondaryText}" />
		</Style>
		<Style Selector="Ellipse.status.connecting">
			<Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
		</Style>
		<Style Selector="Ellipse.status.connected">
			<Setter Property="Fill" Value="{DynamicResource PositiveBrush}" />
		</Style>
		<Style Selector="Ellipse.status.failed">
			<Setter Property="Fill" Value="{DynamicResource NegativeBrush}" />
		</Style>
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="MinHeight" Value="34" />
			<Setter Property="Padding" Value="10,0" />
		</Style>
		<Style Selector="TextBlock.positive">
			<Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
		</Style>
		<Style Selector="TextBlock.negative">
			<Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
		</Style>
		<Style Selector="TextBlock.warning">
			<Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
		</Style>
		<Style Selector="DataGrid">
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="DataGridCell">
			<Setter Property="MinHeight" Value="26" />
		</Style>
		<!-- Privacy mode: a ComboBox.sensitive masks its items (account pickers) -->
		<Style Selector="ComboBox.sensitive">
			<Setter Property="ItemTemplate">
				<DataTemplate x:DataType="x:String">
					<controls:SensitiveTextBlock Text="{Binding}" />
				</DataTemplate>
			</Setter>
		</Style>
	</Application.Styles>
</Application>
