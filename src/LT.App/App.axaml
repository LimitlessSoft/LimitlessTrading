<Application
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:chrome="using:Avalonia.Controls.Chrome"
	x:Class="LT.App.App"
	RequestedThemeVariant="Dark"
>
	<Application.Resources>
		<SolidColorBrush x:Key="PanelBackground" Color="#1B1E24" />
		<SolidColorBrush x:Key="PanelStroke" Color="#2C313A" />
		<SolidColorBrush x:Key="SecondaryText" Color="#8A93A3" />
		<SolidColorBrush x:Key="PositiveBrush" Color="#26A69A" />
		<SolidColorBrush x:Key="NegativeBrush" Color="#EF5350" />
		<SolidColorBrush x:Key="WarningBrush" Color="#FFB74D" />
		<SolidColorBrush x:Key="AtmBrush" Color="#2A3140" />

		<!-- Error badge (e.g. a watchlist row whose quotes failed), on a 12×12 grid -->
		<StreamGeometry x:Key="ErrorIcon">
			F0 M6,0 A6,6 0 1 1 6,12 A6,6 0 1 1 6,0 Z M5.25,2.5 H6.75 V7.25 H5.25 Z M5.25,8.5 H6.75 V10 H5.25 Z
		</StreamGeometry>
		<!-- Widget frame header actions, drawn on a 12×12 grid -->
		<StreamGeometry x:Key="FrameCloseIcon">
			M2.2,1.1 L6,4.9 L9.8,1.1 L10.9,2.2 L7.1,6 L10.9,9.8 L9.8,10.9 L6,7.1 L2.2,10.9 L1.1,9.8 L4.9,6 L1.1,2.2 Z
		</StreamGeometry>
		<!-- Window buttons in the app's own title bar, on a 12×12 grid (close reuses FrameCloseIcon) -->
		<StreamGeometry x:Key="WindowMinimizeIcon">M1,5.4 H11 V6.6 H1 Z</StreamGeometry>
		<StreamGeometry x:Key="WindowMaximizeIcon">
			M1,1 H11 V11 H1 Z M2.2,2.2 V9.8 H9.8 V2.2 Z
		</StreamGeometry>
		<StreamGeometry x:Key="WindowRestoreIcon">
			M3,1 H11 V9 H9 V7.8 H9.8 V2.2 H4.2 V3 H3 Z M1,3 H9 V11 H1 Z M2.2,4.2 V9.8 H7.8 V4.2 Z
		</StreamGeometry>
		<!-- Material Design "pin" (Apache-2.0), on a 24×24 grid -->
		<StreamGeometry x:Key="FramePinIcon">
			M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z
		</StreamGeometry>
		<!-- Material Design "pencil" (Apache-2.0), on a 24×24 grid -->
		<StreamGeometry x:Key="FrameRenameIcon">
			M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z
		</StreamGeometry>
		<!-- Four corners pointing out (fullscreen) / in (restore) -->
		<StreamGeometry x:Key="FrameFullscreenIcon">
			M1,1 H5 V2.5 H2.5 V5 H1 Z M7,1 H11 V5 H9.5 V2.5 H7 Z M1,7 H2.5 V9.5 H5 V11 H1 Z M11,7 V11 H7 V9.5 H9.5 V7 Z
		</StreamGeometry>
		<StreamGeometry x:Key="FrameRestoreIcon">
			M3.5,1 H5 V5 H1 V3.5 H3.5 Z M7,1 H8.5 V3.5 H11 V5 H7 Z M1,7 H5 V11 H3.5 V8.5 H1 Z M7,7 H11 V8.5 H8.5 V11 H7 Z
		</StreamGeometry>
		<StreamGeometry x:Key="ChevronDownIcon">
			M1.6,3.6 L6,8 L10.4,3.6 L11.4,4.6 L6,10 L0.6,4.6 Z
		</StreamGeometry>
		<!-- Material Design "link" (Apache-2.0), on a 24×24 grid -->
		<StreamGeometry x:Key="FrameLinkIcon">
			M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z
		</StreamGeometry>
		<!-- Center view tab strip: add a view -->
		<StreamGeometry x:Key="ViewAddIcon">
			M5.3,1 H6.7 V5.3 H11 V6.7 H6.7 V11 H5.3 V6.7 H1 V5.3 H5.3 Z
		</StreamGeometry>
		<SolidColorBrush x:Key="FrameActionHoverBrush" Color="#2C323C" />
		<SolidColorBrush x:Key="CurrentFrameBrush" Color="#7FA7E8" Opacity="0.55" />
		<SolidColorBrush x:Key="FrameCloseHoverBrush" Color="#3A2326" />

		<!-- Flush layout: a splitter is a 7px grab area over its neighbours with a 1px line in the
		     middle (stops at 3/7 and 4/7) -->
		<LinearGradientBrush x:Key="FlushSplitterColumnBrush" StartPoint="0%,50%" EndPoint="100%,50%">
			<GradientStop Offset="0.4285" Color="Transparent" />
			<GradientStop Offset="0.4285" Color="#2C313A" />
			<GradientStop Offset="0.5714" Color="#2C313A" />
			<GradientStop Offset="0.5714" Color="Transparent" />
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="FlushSplitterRowBrush" StartPoint="50%,0%" EndPoint="50%,100%">
			<GradientStop Offset="0.4285" Color="Transparent" />
			<GradientStop Offset="0.4285" Color="#2C313A" />
			<GradientStop Offset="0.5714" Color="#2C313A" />
			<GradientStop Offset="0.5714" Color="Transparent" />
		</LinearGradientBrush>

		<!-- appChrome windows: no drawn border or shadow, the app's own panels frame them -->
		<ControlTheme
			x:Key="AppWindowDecorations"
			TargetType="chrome:WindowDrawnDecorations"
			BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}"
		>
			<Setter Property="DefaultFrameThickness" Value="0" />
			<Setter Property="DefaultShadowThickness" Value="0" />
		</ControlTheme>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

		<!-- The app's own window chrome (the OS title bar is off); put a WindowTitleBar on top -->
		<Style Selector=":is(Window).appChrome">
			<Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
			<Setter Property="WindowDecorations" Value="BorderOnly" />
			<Setter Property="WindowDecorationsTheme" Value="{StaticResource AppWindowDecorations}" />
		</Style>

		<Style Selector="Border.panel">
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10" />
		</Style>
		<Style Selector="Border.panel.docked">
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<!-- The current widget (last clicked or typed in): a light frame. Docked side widgets have no
		     border, so they get one here with 1px less padding to keep content put. -->
		<Style Selector="Border.panel.current">
			<Setter Property="BorderBrush" Value="{DynamicResource CurrentFrameBrush}" />
		</Style>
		<Style Selector="Border.panel.docked.current">
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="9" />
		</Style>
		<!-- Flush layout (Settings → Appearance): every widget gets the docked look, square and
		     borderless, filling its cell; the current one keeps its light frame -->
		<Style Selector=":is(Window).flush Border.panel">
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector=":is(Window).flush Border.panel.current">
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="9" />
		</Style>
		<!-- Fullscreen widget: an orange frame says you're not looking at the normal layout.
		     After .docked so it wins for side widgets too; 1px less padding keeps content put. -->
		<Style Selector="Border.panel.fullscreen">
			<Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="9" />
		</Style>
		<Style Selector=":is(Window).flush Border.panel.fullscreen">
			<Setter Property="CornerRadius" Value="0" />
		</Style>
		<Style Selector="TextBlock.panelTitle">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.secondary">
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="TextBlock.value">
			<Setter Property="FontFeatures" Value="tnum" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>
		<Style Selector="Border.strip">
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
			<Setter Property="Padding" Value="4,8" />
		</Style>
		<!-- The bottom strip lays its icons out in a row -->
		<Style Selector="Border.strip.horizontal">
			<Setter Property="Padding" Value="8,4" />
		</Style>
		<Style Selector="Border.strip.horizontal Button.tool">
			<Setter Property="Margin" Value="0,0,4,0" />
		</Style>
		<Style Selector="Border.toolbar">
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="Padding" Value="4,4,4,0" />
		</Style>
		<!-- Title bar window buttons: flat, full toolbar height; close turns red on hover -->
		<Style Selector="Button.windowButton">
			<Setter Property="Width" Value="46" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.windowButton PathIcon">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="10" />
		</Style>
		<Style Selector="Button.windowButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.windowButton.close:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#C42B1C" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<!-- Title bar "Update x.y.z": a small accent pill left of the window buttons -->
		<Style Selector="Button.update">
			<Setter Property="Height" Value="24" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.update:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.tool">
			<Setter Property="Width" Value="36" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0,0,0,4" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
		</Style>
		<Style Selector="Button.tool PathIcon">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
		</Style>
		<Style Selector="Button.tool.active">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.tool.active:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<!-- Center view tabs: quiet until hovered; the shown one is lit and underlined -->
		<Style Selector="Border.viewTabs">
			<Setter Property="Padding" Value="0,6,0,0" />
		</Style>
		<Style Selector=":is(Window).flush Border.viewTabs">
			<Setter Property="Padding" Value="4,4,4,0" />
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}" />
			<Setter Property="BorderThickness" Value="0,0,0,1" />
		</Style>
		<Style Selector="Border.viewTab">
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="12,0,6,0" />
			<Setter Property="CornerRadius" Value="6,6,0,0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0,0,0,2" />
			<Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryText}" />
		</Style>
		<Style Selector="Border.viewTab:pointerover">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<Style Selector="Border.viewTab.selected">
			<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="TextElement.Foreground" Value="White" />
		</Style>
		<Style Selector="Border.viewTab TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Margin" Value="0,0,6,0" />
		</Style>
		<Style Selector="TextBox.viewName">
			<Setter Property="MinHeight" Value="24" />
			<Setter Property="MinWidth" Value="100" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Padding" Value="6,2" />
			<Setter Property="Margin" Value="0,0,6,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.frameAction.viewClose">
			<Setter Property="Width" Value="20" />
			<Setter Property="Height" Value="20" />
		</Style>
		<Style Selector="Button.frameAction.viewAdd">
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="28" />
			<Setter Property="Margin" Value="4,0,0,0" />
		</Style>
		<Style Selector="Border.dropTarget">
			<Setter Property="Background" Value="#332F7BF6" />
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<!-- Widget frame header actions: quiet until the frame is hovered, close turns red -->
		<Style Selector="StackPanel.frameActions">
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="UserControl:pointerover StackPanel.frameActions">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<!-- Chart header title: reads as the title, hints it can be clicked -->
		<Style Selector="Button.chartTitle">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,1" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="Button.chartTitle:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<!-- Chart header timeframe beside the title: quieter than the title, same hover hint -->
		<Style Selector="Button.chartTimeframe">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,1" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
		</Style>
		<Style Selector="Button.chartTimeframe:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<!-- Watchlist header: the picker reads as the title; its rows are flat full-width buttons -->
		<Style Selector="Button.watchlistPicker">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,1" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="Button.watchlistPicker:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<Style Selector="Button.pickerRow">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="Button.pickerRow:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
		</Style>
		<Style Selector="Button.pickerRow.active">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource SystemAccentColorLight2}" />
		</Style>
		<Style Selector="TextBox.watchlistName">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="FontSize" Value="13" />
		</Style>
		<!-- Confirms something that can't be undone (e.g. deleting a watchlist) -->
		<Style Selector="Button.danger">
			<Setter Property="Background" Value="#C42B1C" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="AutoCompleteBox.ticker">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="Button.frameAction">
			<Setter Property="Width" Value="24" />
			<Setter Property="Height" Value="24" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="5" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.frameAction PathIcon">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="10" />
		</Style>
		<Style Selector="Button.frameAction.pin PathIcon">
			<Setter Property="Width" Value="12" />
			<Setter Property="Height" Value="12" />
		</Style>
		<!-- Unpinned: the pin tilts and dims -->
		<Style Selector="Button.frameAction.pin.unpinned PathIcon">
			<Setter Property="Opacity" Value="0.6" />
			<Setter Property="RenderTransform" Value="rotate(45deg)" />
		</Style>
		<Style Selector="Button.frameAction.link PathIcon">
			<Setter Property="Width" Value="14" />
			<Setter Property="Height" Value="14" />
		</Style>
		<Style Selector="Button.frameAction:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameActionHoverBrush}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.frameAction:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource PanelStroke}" />
		</Style>
		<Style Selector="Button.frameAction.close:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FrameCloseHoverBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
		</Style>
		<Style Selector="Button.statusItem">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4,1" />
			<Setter Property="MinHeight" Value="0" />
		</Style>
		<Style Selector="Ellipse.status">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="10" />
			<Setter Property="Fill" Value="{DynamicResource SecondaryText}" />
		</Style>
		<Style Selector="Ellipse.status.connecting">
			<Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
		</Style>
		<Style Selector="Ellipse.status.connected">
			<Setter Property="Fill" Value="{DynamicResource PositiveBrush}" />
		</Style>
		<Style Selector="Ellipse.status.failed">
			<Setter Property="Fill" Value="{DynamicResource NegativeBrush}" />
		</Style>
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="MinHeight" Value="34" />
			<Setter Property="Padding" Value="10,0" />
		</Style>
		<Style Selector="TextBlock.positive">
			<Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
		</Style>
		<Style Selector="TextBlock.negative">
			<Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
		</Style>
		<Style Selector="TextBlock.warning">
			<Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
		</Style>
		<Style Selector="DataGrid">
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="DataGridCell">
			<Setter Property="MinHeight" Value="26" />
		</Style>
	</Application.Styles>
</Application>
