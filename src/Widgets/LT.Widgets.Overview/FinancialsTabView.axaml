<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Overview"
	x:Class="LT.App.Widgets.Overview.FinancialsTabView"
	x:DataType="vm:FinancialsTabViewModel"
>
	<UserControl.Styles>
		<Style Selector="ToggleButton.period">
			<Setter Property="MinWidth" Value="72" />
			<Setter Property="Padding" Value="8,3" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
		<!-- Worked out, not reported: dimmed (Inter has no italic, a slanted B reads as a Cyrillic letter) -->
		<Style Selector="TextBlock.derived">
			<Setter Property="Opacity" Value="0.6" />
		</Style>
		<!-- Every value column one width, right aligned, so the periods line up row to row -->
		<Style Selector="TextBlock.cell">
			<Setter Property="Width" Value="92" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontFeatures" Value="+tnum" />
			<Setter Property="TextAlignment" Value="Right" />
		</Style>
	</UserControl.Styles>

	<DockPanel Margin="4,8,4,4">
		<StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="6">
			<WrapPanel Orientation="Horizontal" IsVisible="{Binding HasStatements}">
				<StackPanel Margin="0,0,12,0" Orientation="Horizontal" Spacing="2">
					<ToggleButton Classes="period" Content="Annual" IsChecked="{Binding IsAnnual}" />
					<ToggleButton Classes="period" Content="Quarterly" IsChecked="{Binding IsQuarterly}" />
				</StackPanel>
				<TextBlock
					VerticalAlignment="Center"
					Classes="secondary"
					FontSize="12"
					TextTrimming="CharacterEllipsis"
					Text="{Binding SourceText}"
				/>
			</WrapPanel>
			<StackPanel
				Orientation="Horizontal"
				Spacing="8"
				IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			>
				<ProgressBar
					Width="48"
					MinWidth="48"
					VerticalAlignment="Center"
					IsIndeterminate="True"
					IsVisible="{Binding IsLoading}"
				/>
				<TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding StatusText}" />
			</StackPanel>
			<!-- Multiples at the live price -->
			<ItemsControl ItemsSource="{Binding Valuation}" IsVisible="{Binding HasStatements}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:OverviewField">
						<StackPanel
							Width="110"
							Margin="0,2,6,0"
							Background="Transparent"
							ToolTip.Tip="{Binding ToolTip}"
						>
							<TextBlock Classes="statLabel" Text="{Binding Label}" />
							<TextBlock Classes="statValue" Text="{Binding Value}" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>

		<!-- Lines down, periods across (newest first); scrolls both ways in a narrow widget -->
		<ScrollViewer
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto"
			IsVisible="{Binding HasStatements}"
		>
			<StackPanel Margin="0,0,0,4">
				<StackPanel Margin="0,0,0,6" Orientation="Horizontal">
					<Border Width="180" />
					<ItemsControl ItemsSource="{Binding Columns}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:FinancialColumn">
								<StackPanel Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
									<TextBlock Classes="cell" FontWeight="SemiBold" Text="{Binding Name}" />
									<TextBlock Classes="cell secondary" FontSize="11" Text="{Binding EndText}" />
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
				<ItemsControl ItemsSource="{Binding Sections}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:FinancialSection">
							<StackPanel Margin="0,0,0,12">
								<TextBlock
									Margin="0,0,0,4"
									Classes="secondary"
									FontSize="11"
									FontWeight="SemiBold"
									Text="{Binding Title}"
								/>
								<ItemsControl ItemsSource="{Binding Rows}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:FinancialRow">
											<StackPanel Margin="0,2" Orientation="Horizontal">
												<TextBlock
													Width="180"
													Background="Transparent"
													Classes="secondary"
													FontSize="13"
													TextTrimming="CharacterEllipsis"
													Text="{Binding Label}"
													ToolTip.Tip="{Binding ToolTip}"
												/>
												<ItemsControl ItemsSource="{Binding Cells}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<StackPanel Orientation="Horizontal" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="vm:FinancialCell">
															<TextBlock
																Classes="cell"
																Background="Transparent"
																Classes.negative="{Binding IsNegative}"
																Classes.derived="{Binding IsDerived}"
																Text="{Binding Text}"
																ToolTip.Tip="{Binding ToolTip}"
															/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<TextBlock
					Classes="secondary"
					FontSize="11"
					TextWrapping="Wrap"
					MaxWidth="560"
					HorizontalAlignment="Left"
					Text="Dimmed: a quarter not reported as such, worked out from the years to date (hover for details). Amounts in USD as filed; capital expenditure, dividends and buybacks are payments (positive)."
				/>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</UserControl>
