<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Executions"
	xmlns:helpers="using:LT.App.Helpers"
	x:Class="LT.App.Widgets.Executions.ExecutionsView"
	x:DataType="vm:ExecutionsViewModel"
>
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
			<Button
				Content="Refresh"
				Command="{Binding RefreshCommand}"
				IsEnabled="{Binding IsConnected}"
			/>
			<TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding UpdatedText}" />
			<TextBlock
				VerticalAlignment="Center"
				Classes="warning"
				Text="{Binding StaleText}"
				IsVisible="{Binding IsStale}"
			/>
			<TextBlock
				VerticalAlignment="Center"
				Classes="negative"
				Text="{Binding ErrorMessage}"
				IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			/>
		</StackPanel>
		<!-- Rows drag onto a chart (TickerDragDrop) -->
		<DataGrid
			helpers:TickerDragDrop.IsSource="True"
			ItemsSource="{Binding Executions}"
			SelectedItem="{Binding SelectedExecution}"
			IsReadOnly="True"
			CanUserSortColumns="True"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
		>
			<DataGrid.Columns>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Time"
					Binding="{Binding TimeText}"
					SortMemberPath="Execution.Time"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Account"
					Binding="{Binding Execution.Account}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Symbol"
					Binding="{Binding Execution.Symbol}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Type"
					Binding="{Binding Execution.SecurityType}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Side"
					Binding="{Binding Execution.Side}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Shares"
					Binding="{Binding Execution.Shares, StringFormat='{}{0:#,0.####}'}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Price"
					Binding="{Binding Execution.Price, StringFormat='{}{0:#,0.00##}'}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Exchange"
					Binding="{Binding Execution.Exchange}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Commission"
					Binding="{Binding Execution.Commission, StringFormat='{}{0:#,0.00##}'}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Ccy"
					Binding="{Binding Execution.CommissionCurrency}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Realized P&amp;L"
					Binding="{Binding Execution.RealizedPnl, StringFormat='{}{0:+#,0.00;-#,0.00;0.00}'}"
				/>
				<DataGridTextColumn
					x:DataType="vm:ExecutionRowViewModel"
					Header="Order"
					Binding="{Binding Execution.OrderId}"
				/>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
