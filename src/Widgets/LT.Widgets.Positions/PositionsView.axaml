<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Positions"
	xmlns:helpers="using:LT.App.Helpers"
	x:Class="LT.App.Widgets.Positions.PositionsView"
	x:DataType="vm:PositionsViewModel"
>
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
			<Button
				Content="Refresh"
				Command="{Binding RefreshCommand}"
				IsEnabled="{Binding IsConnected}"
			/>
			<TextBlock
				VerticalAlignment="Center"
				Classes="secondary"
				Text="Connect to TWS / IB Gateway to load positions."
				IsVisible="{Binding ShowConnectHint}"
			/>
			<TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding TotalsText}" />
			<TextBlock
				VerticalAlignment="Center"
				Classes="warning"
				Text="{Binding StaleText}"
				IsVisible="{Binding IsStale}"
			/>
			<TextBlock
				VerticalAlignment="Center"
				Classes="negative"
				Text="{Binding ErrorMessage}"
				IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			/>
		</StackPanel>
		<!-- Rows drag onto a chart (TickerDragDrop) -->
		<DataGrid
			helpers:TickerDragDrop.IsSource="True"
			ItemsSource="{Binding Positions}"
			SelectedItem="{Binding SelectedPosition}"
			IsReadOnly="True"
			CanUserSortColumns="True"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
		>
			<DataGrid.Columns>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Account"
					Binding="{Binding Account}"
				/>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Symbol"
					Binding="{Binding Symbol}"
				/>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Type"
					Binding="{Binding SecurityType}"
				/>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Exchange"
					Binding="{Binding Exchange}"
				/>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Ccy"
					Binding="{Binding Currency}"
				/>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Quantity"
					Binding="{Binding Quantity}"
				/>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Avg cost"
					Binding="{Binding AverageCost}"
				/>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Market value"
					Binding="{Binding MarketValue}"
				/>
				<DataGridTemplateColumn Header="Unrealized P&amp;L">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:PositionRowViewModel">
							<TextBlock
								Classes="value"
								Margin="8,0"
								VerticalAlignment="Center"
								Classes.positive="{Binding UnrealizedUp}"
								Classes.negative="{Binding UnrealizedDown}"
								Text="{Binding UnrealizedPnl}"
							/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="Daily P&amp;L">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:PositionRowViewModel">
							<TextBlock
								Classes="value"
								Margin="8,0"
								VerticalAlignment="Center"
								Classes.positive="{Binding DailyUp}"
								Classes.negative="{Binding DailyDown}"
								Text="{Binding DailyPnl}"
							/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn
					x:DataType="vm:PositionRowViewModel"
					Header="Realized P&amp;L"
					Binding="{Binding RealizedPnl}"
				/>
				<!-- Opens a pre-filled order ticket; nothing is sent from here -->
				<DataGridTemplateColumn CanUserSort="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:PositionRowViewModel">
							<Button
								Classes="frameAction close closePosition"
								Margin="4,0"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								ToolTip.Tip="Close position"
								Command="{Binding $parent[DataGrid].((vm:PositionsViewModel)DataContext).ClosePositionCommand}"
								CommandParameter="{Binding}"
								IsEnabled="{Binding $parent[DataGrid].((vm:PositionsViewModel)DataContext).CanClose}"
							>
								<PathIcon Data="{StaticResource ClosePositionIcon}" />
							</Button>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!-- Quick exit: sends a market order for the whole position at once, no ticket -->
				<DataGridTemplateColumn CanUserSort="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:PositionRowViewModel">
							<Button
								Classes="frameAction close closePosition"
								Margin="4,0"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								ToolTip.Tip="Quick exit: close the whole position at market now"
								Command="{Binding $parent[DataGrid].((vm:PositionsViewModel)DataContext).QuickExitCommand}"
								CommandParameter="{Binding}"
							>
								<Button.IsEnabled>
									<MultiBinding Converter="{x:Static BoolConverters.And}">
										<Binding Path="$parent[DataGrid].((vm:PositionsViewModel)DataContext).CanClose" />
										<Binding Path="CanQuickExit" />
									</MultiBinding>
								</Button.IsEnabled>
								<PathIcon Data="{StaticResource QuickExitIcon}" />
							</Button>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
