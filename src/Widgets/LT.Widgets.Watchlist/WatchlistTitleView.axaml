<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Watchlist"
	x:Class="LT.App.Widgets.Watchlist.WatchlistTitleView"
	x:DataType="vm:WatchlistViewModel"
>
	<!-- Watchlist header title: the shown watchlist; click it for the list, where each row can be
	     switched to, renamed (pencil) or deleted (✕), then rows to add, import and export a
	     watchlist, and every column: shown or hidden, sorted by, and the shown watchlist's custom
	     columns renamed or deleted -->
	<Button x:Name="PickerButton" Classes="watchlistPicker" ToolTip.Tip="Watchlists">
		<StackPanel Orientation="Horizontal" Spacing="6">
			<TextBlock
				FontWeight="SemiBold"
				VerticalAlignment="Center"
				Text="{Binding ActiveWatchlist.Name, FallbackValue=''}"
			/>
			<PathIcon
				Width="9"
				Height="9"
				VerticalAlignment="Center"
				Data="{StaticResource ChevronDownIcon}"
			/>
		</StackPanel>
		<Button.Flyout>
			<Flyout Placement="BottomEdgeAlignedLeft">
				<StackPanel Width="280" Spacing="2">
					<ItemsControl ItemsSource="{Binding Watchlists}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:WatchlistItemViewModel">
								<Panel MinHeight="30">
									<Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsIdle}">
										<Button
											Classes="pickerRow"
											Classes.active="{Binding IsActive}"
											Click="OnRowPicked"
											HorizontalContentAlignment="Stretch"
										>
											<!-- Name left, symbol count right-aligned in its own column -->
											<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
												<TextBlock
													VerticalAlignment="Center"
													TextTrimming="CharacterEllipsis"
													Text="{Binding Name}"
												/>
												<TextBlock
													Grid.Column="1"
													Classes="secondary"
													FontSize="12"
													VerticalAlignment="Center"
													Text="{Binding Count}"
												/>
											</Grid>
										</Button>
										<Button
											Grid.Column="1"
											Classes="frameAction"
											VerticalAlignment="Center"
											ToolTip.Tip="Rename"
											Command="{Binding Owner.BeginRenameCommand}"
											CommandParameter="{Binding}"
										>
											<PathIcon Data="{StaticResource FrameRenameIcon}" />
										</Button>
										<Button
											Grid.Column="2"
											Classes="frameAction close"
											VerticalAlignment="Center"
											ToolTip.Tip="{Binding DeleteToolTip}"
											ToolTip.ShowOnDisabled="True"
											Command="{Binding Owner.AskDeleteCommand}"
											CommandParameter="{Binding}"
											IsEnabled="{Binding Owner.CanDelete}"
										>
											<PathIcon Data="{StaticResource FrameCloseIcon}" />
										</Button>
									</Grid>
									<TextBox
										Classes="watchlistName"
										Text="{Binding RenameText}"
										PlaceholderText="Watchlist name"
										IsVisible="{Binding IsRenaming}"
										PropertyChanged="OnRenameBoxPropertyChanged"
										KeyDown="OnRenameBoxKeyDown"
										LostFocus="OnRenameBoxLostFocus"
									/>
									<Grid
										ColumnDefinitions="*,Auto,Auto"
										ColumnSpacing="6"
										IsVisible="{Binding IsConfirmingDelete}"
									>
										<TextBlock
											VerticalAlignment="Center"
											TextTrimming="CharacterEllipsis"
											Text="{Binding DeletePrompt}"
										/>
										<Button
											Grid.Column="1"
											Content="Cancel"
											Command="{Binding Owner.CancelDeleteCommand}"
											CommandParameter="{Binding}"
										/>
										<Button
											Grid.Column="2"
											Classes="danger"
											Content="Delete"
											Command="{Binding Owner.ConfirmDeleteCommand}"
											CommandParameter="{Binding}"
										/>
									</Grid>
								</Panel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Separator Margin="0,2" />
					<Button Classes="pickerRow" Command="{Binding NewWatchlistCommand}">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Classes="secondary" Text="+" />
							<TextBlock Text="New watchlist" />
						</StackPanel>
					</Button>
					<!-- A JSON export, or a list of symbols (one per line or comma-separated) -->
					<Button
						Classes="pickerRow"
						Click="OnImportClick"
						IsEnabled="{Binding !IsImporting}"
						ToolTip.Tip="A watchlist exported here, or a text / CSV list of symbols (one per line or comma-separated)"
					>
						<TextBlock Text="Import watchlist…" />
					</Button>
					<Button Classes="pickerRow" Click="OnExportClick">
						<TextBlock
							TextTrimming="CharacterEllipsis"
							Text="{Binding ActiveWatchlist.Name, StringFormat='Export {0}…', FallbackValue='Export…'}"
						/>
					</Button>
					<Separator Margin="0,2" />
					<!-- Every column: show / hide (check box; the last shown one stays) and sort by
					     it (arrow; shown or hidden, a click flips the direction), then the shown
					     watchlist's own columns rename (pencil) and delete (✕); add below -->
					<Grid ColumnDefinitions="*,Auto" Margin="8,2,0,2">
						<TextBlock
							Classes="secondary"
							FontSize="12"
							VerticalAlignment="Center"
							Text="Columns"
						/>
						<Button
							Grid.Column="1"
							Classes="pickerRow"
							Padding="6,0"
							MinHeight="0"
							FontSize="12"
							Content="Clear sort"
							Command="{Binding ClearSortCommand}"
							IsVisible="{Binding HasSort}"
						/>
					</Grid>
					<ItemsControl ItemsSource="{Binding Columns}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:WatchlistColumnOptionViewModel">
								<Panel MinHeight="30">
									<Grid
										ColumnDefinitions="Auto,*,Auto,Auto,Auto"
										IsVisible="{Binding Custom.IsIdle, FallbackValue=True}"
									>
										<CheckBox
											Margin="8,0,0,0"
											MinWidth="0"
											VerticalAlignment="Center"
											IsChecked="{Binding IsShown}"
											IsEnabled="{Binding CanToggle}"
											ToolTip.Tip="Show on the grid (the last shown column stays)"
										/>
										<TextBlock
											Grid.Column="1"
											Margin="4,0"
											VerticalAlignment="Center"
											TextTrimming="CharacterEllipsis"
											Classes.secondary="{Binding !IsShown}"
											Text="{Binding Name}"
										/>
										<Button
											Grid.Column="2"
											Classes="frameAction"
											VerticalAlignment="Center"
											ToolTip.Tip="{Binding SortToolTip}"
											Command="{Binding Owner.SortByColumnCommand}"
											CommandParameter="{Binding}"
										>
											<TextBlock
												FontSize="12"
												Classes.secondary="{Binding !IsSorted}"
												Text="{Binding SortGlyph}"
											/>
										</Button>
										<Button
											Grid.Column="3"
											Classes="frameAction"
											VerticalAlignment="Center"
											ToolTip.Tip="Rename"
											IsVisible="{Binding IsCustom}"
											Command="{Binding Owner.BeginRenameColumnCommand}"
											CommandParameter="{Binding Custom}"
										>
											<PathIcon Data="{StaticResource FrameRenameIcon}" />
										</Button>
										<Button
											Grid.Column="4"
											Classes="frameAction close"
											VerticalAlignment="Center"
											ToolTip.Tip="Delete"
											IsVisible="{Binding IsCustom}"
											Command="{Binding Owner.AskDeleteColumnCommand}"
											CommandParameter="{Binding Custom}"
										>
											<PathIcon Data="{StaticResource FrameCloseIcon}" />
										</Button>
									</Grid>
									<!-- A custom column's rename box and delete confirmation -->
									<ContentControl Content="{Binding Custom}">
										<ContentControl.ContentTemplate>
											<DataTemplate x:DataType="vm:WatchlistColumnItemViewModel">
												<Panel IsVisible="{Binding !IsIdle}">
													<TextBox
														Classes="watchlistName"
														Text="{Binding RenameText}"
														PlaceholderText="Column name"
														IsVisible="{Binding IsRenaming}"
														PropertyChanged="OnRenameBoxPropertyChanged"
														KeyDown="OnRenameBoxKeyDown"
														LostFocus="OnRenameBoxLostFocus"
													/>
													<Grid
														ColumnDefinitions="*,Auto,Auto"
														ColumnSpacing="6"
														IsVisible="{Binding IsConfirmingDelete}"
													>
														<TextBlock
															VerticalAlignment="Center"
															TextTrimming="CharacterEllipsis"
															Text="Delete with its values?"
														/>
														<Button
															Grid.Column="1"
															Content="Cancel"
															Command="{Binding Owner.CancelDeleteColumnCommand}"
															CommandParameter="{Binding}"
														/>
														<Button
															Grid.Column="2"
															Classes="danger"
															Content="Delete"
															Command="{Binding Owner.ConfirmDeleteColumnCommand}"
															CommandParameter="{Binding}"
														/>
													</Grid>
												</Panel>
											</DataTemplate>
										</ContentControl.ContentTemplate>
									</ContentControl>
								</Panel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button
						Classes="pickerRow"
						Command="{Binding AddColumnCommand}"
						IsEnabled="{Binding CanAddColumn}"
					>
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Classes="secondary" Text="+" />
							<TextBlock Text="Add column" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Flyout>
		</Button.Flyout>
	</Button>
</UserControl>
