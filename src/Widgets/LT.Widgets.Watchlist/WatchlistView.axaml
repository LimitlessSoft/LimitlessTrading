<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Watchlist"
	xmlns:helpers="using:LT.App.Helpers"
	xmlns:controls="using:LT.App.Controls"
	xmlns:enums="using:LT.Contracts.Enums"
	x:Class="LT.App.Widgets.Watchlist.WatchlistView"
	x:DataType="vm:WatchlistViewModel"
>
	<DockPanel>
		<!-- Typing lists IB's listings of the symbol; pick one or press Enter to add it. Esc clears
		     it; on an empty box Esc goes to the workspace (an unpinned docked watchlist collapses) -->
		<controls:ContractSearchBox
			x:Name="SearchBox"
			PassesIdleEscape="True"
			DockPanel.Dock="Top"
			Margin="0,0,0,6"
			Placeholder="Add symbol (Ctrl+F)"
		/>

		<TextBlock
			DockPanel.Dock="Top"
			Classes="negative"
			FontSize="12"
			TextWrapping="Wrap"
			Margin="0,0,0,6"
			Text="{Binding ErrorMessage}"
			IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
		/>

		<!-- Import / export result -->
		<TextBlock
			DockPanel.Dock="Top"
			Classes="secondary"
			FontSize="12"
			TextWrapping="Wrap"
			Margin="0,0,0,6"
			Text="{Binding StatusMessage}"
			IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
		/>

		<!-- Rows drag onto a chart (TickerDragDrop). Sorting is the view model's (OnGridSorting):
		     pinned rows stay on top in pin order, the rest follow the clicked column. Custom
		     columns are added after these by the view (RebuildCustomColumns); only their cells are
		     editable (click a selected row's cell or F2, Enter saves, Esc cancels) -->
		<DataGrid
			x:Name="Grid"
			helpers:TickerDragDrop.IsSource="True"
			ItemsSource="{Binding Rows}"
			SelectedItem="{Binding SelectedRow}"
			IsReadOnly="False"
			CanUserSortColumns="True"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
			KeyDown="OnGridKeyDown"
			Sorting="OnGridSorting"
			PreparingCellForEdit="OnPreparingCellForEdit"
			CellEditEnded="OnCellEditEnded"
		>
			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem
						Header="Pin to top"
						Command="{Binding PinCommand}"
						IsVisible="{Binding CanPin}"
					/>
					<MenuItem
						Header="Unpin"
						Command="{Binding UnpinCommand}"
						IsVisible="{Binding CanUnpin}"
					/>
					<MenuItem Header="Remove from watchlist" Command="{Binding RemoveCommand}" />
				</ContextMenu>
			</DataGrid.ContextMenu>
			<DataGrid.Columns>
				<DataGridTemplateColumn
					IsReadOnly="True"
					Header="Symbol"
					Width="*"
					MinWidth="130"
					SortMemberPath="Symbol"
					Tag="{x:Static enums:WatchlistSortColumn.Symbol}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<StackPanel Margin="8,2" VerticalAlignment="Center">
								<StackPanel Orientation="Horizontal" Spacing="4">
									<!-- Pinned to the top -->
									<PathIcon
										Width="10"
										Height="10"
										VerticalAlignment="Center"
										Background="Transparent"
										Foreground="{DynamicResource SecondaryText}"
										Data="{StaticResource FramePinIcon}"
										IsVisible="{Binding IsPinned}"
										ToolTip.Tip="Pinned to the top"
									/>
									<TextBlock FontWeight="SemiBold" Text="{Binding Symbol}" />
									<TextBlock
										Classes="warning"
										FontSize="10"
										Text="D"
										VerticalAlignment="Center"
										IsVisible="{Binding IsDelayed}"
										ToolTip.Tip="Delayed data"
									/>
									<!-- Quote errors: the message is on hover, so the row keeps its height -->
									<PathIcon
										Width="12"
										Height="12"
										VerticalAlignment="Center"
										Background="Transparent"
										Foreground="{DynamicResource NegativeBrush}"
										Data="{StaticResource ErrorIcon}"
										IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
										ToolTip.Tip="{Binding Error}"
									/>
								</StackPanel>
								<TextBlock Classes="secondary" FontSize="10" Text="{Binding Description}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					IsReadOnly="True"
					Header="Last"
					Width="Auto"
					SortMemberPath="LastValue"
					Tag="{x:Static enums:WatchlistSortColumn.Last}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<TextBlock
								Classes="value"
								Margin="8,0"
								VerticalAlignment="Center"
								Text="{Binding Last}"
							/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					IsReadOnly="True"
					Header="Chg %"
					Width="Auto"
					SortMemberPath="ChangePercentValue"
					Tag="{x:Static enums:WatchlistSortColumn.ChangePercent}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<StackPanel Margin="8,0" VerticalAlignment="Center">
								<TextBlock
									Classes="value"
									Classes.positive="{Binding IsUp}"
									Classes.negative="{Binding IsDown}"
									Text="{Binding ChangePercent}"
								/>
								<TextBlock
									Classes="value secondary"
									FontSize="10"
									Classes.positive="{Binding IsUp}"
									Classes.negative="{Binding IsDown}"
									Text="{Binding Change}"
								/>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!-- Sorts by bid -->
				<DataGridTemplateColumn
					IsReadOnly="True"
					Header="Bid / Ask"
					Width="Auto"
					SortMemberPath="BidValue"
					Tag="{x:Static enums:WatchlistSortColumn.Bid}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<StackPanel Margin="8,0" VerticalAlignment="Center">
								<TextBlock Classes="value" FontSize="12" Text="{Binding Bid}" />
								<TextBlock Classes="value" FontSize="12" Text="{Binding Ask}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					IsReadOnly="True"
					Header="Vol"
					Width="Auto"
					SortMemberPath="VolumeValue"
					Tag="{x:Static enums:WatchlistSortColumn.Volume}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<TextBlock
								Classes="value secondary"
								Margin="8,0"
								VerticalAlignment="Center"
								Text="{Binding Volume}"
							/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!-- SEC shares outstanding × last; US stocks only -->
				<DataGridTemplateColumn
					IsReadOnly="True"
					Header="Mkt Cap"
					Width="Auto"
					SortMemberPath="MarketCapValue"
					Tag="{x:Static enums:WatchlistSortColumn.MarketCap}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:WatchlistRowViewModel">
							<TextBlock
								Classes="value secondary"
								Margin="8,0"
								VerticalAlignment="Center"
								Text="{Binding MarketCap}"
							/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
