<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.News"
	x:Class="LT.App.Widgets.News.NewsView"
	x:DataType="vm:NewsViewModel"
>
	<!-- Toolbar (mode, filter, state), provider chips, then the headline list and the reading pane
	     side by side -->
	<DockPanel>
		<DockPanel.Styles>
			<Style Selector="ToggleButton.mode">
				<Setter Property="Padding" Value="10,3" />
				<Setter Property="MinHeight" Value="0" />
				<Setter Property="FontSize" Value="12" />
			</Style>
			<Style Selector="ToggleButton.chip">
				<Setter Property="Padding" Value="8,2" />
				<Setter Property="MinHeight" Value="0" />
				<Setter Property="Margin" Value="0,0,4,4" />
				<Setter Property="FontSize" Value="11" />
				<Setter Property="CornerRadius" Value="10" />
			</Style>
			<Style Selector="ToggleButton.chip.dimmed">
				<Setter Property="Opacity" Value="0.45" />
			</Style>
			<Style Selector="Border.badge">
				<Setter Property="Background" Value="{DynamicResource PanelStroke}" />
				<Setter Property="CornerRadius" Value="3" />
				<Setter Property="Padding" Value="4,0" />
				<Setter Property="Margin" Value="6,0" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
			<Style Selector="Border.badge TextBlock">
				<Setter Property="FontSize" Value="10" />
				<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			</Style>
			<Style Selector="TextBlock.match">
				<Setter Property="FontWeight" Value="SemiBold" />
			</Style>
			<Style Selector="ListBoxItem">
				<Setter Property="Padding" Value="6,3" />
				<Setter Property="MinHeight" Value="0" />
			</Style>
		</DockPanel.Styles>

		<DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
			<StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
				<ToggleButton
					Classes="mode"
					Content="Linked"
					ToolTip.Tip="News of the link group's symbol"
					IsChecked="{Binding IsLinkedMode}"
				/>
				<ToggleButton
					Classes="mode"
					Content="All news"
					ToolTip.Tip="Every headline of the selected providers' broad feeds"
					IsChecked="{Binding IsAllMode}"
				/>
				<ToggleButton
					Classes="mode"
					Content="Search"
					ToolTip.Tip="Search every headline kept in the news archive, all sources"
					IsChecked="{Binding IsSearchMode}"
				/>
			</StackPanel>
			<StackPanel
				DockPanel.Dock="Right"
				Orientation="Horizontal"
				Spacing="4"
				Margin="8,0,0,0"
				VerticalAlignment="Center"
				IsVisible="{Binding IsLive}"
			>
				<Ellipse Width="7" Height="7" Fill="{DynamicResource PositiveBrush}" />
				<TextBlock Classes="secondary" Text="Live" />
			</StackPanel>
			<ToggleButton
				DockPanel.Dock="Right"
				Classes="mode"
				Margin="8,0,0,0"
				Content="Matches"
				ToolTip.Tip="Only headlines matching the news alerts (keywords, watchlist symbols; Settings › News)"
				IsChecked="{Binding OnlyMatches}"
			/>
			<TextBox
				Margin="8,0,0,0"
				MinHeight="0"
				Padding="6,3"
				FontSize="12"
				PlaceholderText="{Binding FilterPlaceholder}"
				Text="{Binding FilterText}"
			/>
		</DockPanel>

		<ItemsControl
			DockPanel.Dock="Top"
			ItemsSource="{Binding Providers}"
			IsVisible="{Binding !IsSearchMode}"
		>
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:NewsProviderChip">
					<ToggleButton
						Classes="chip"
						Classes.dimmed="{Binding IsDimmed}"
						Content="{Binding Label}"
						ToolTip.Tip="{Binding Tip}"
						IsChecked="{Binding IsSelected}"
					/>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<StackPanel DockPanel.Dock="Top" Spacing="2" Margin="2,0,0,4">
			<TextBlock Classes="secondary" Text="Loading…" IsVisible="{Binding IsLoading}" />
			<TextBlock
				Classes="secondary"
				TextWrapping="Wrap"
				Text="{Binding InfoText}"
				IsVisible="{Binding InfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			/>
			<TextBlock
				Classes="negative"
				TextWrapping="Wrap"
				Text="{Binding ErrorMessage}"
				IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			/>
		</StackPanel>

		<Grid ColumnDefinitions="3*,6,2*">
			<DockPanel>
				<Button
					DockPanel.Dock="Bottom"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center"
					Margin="0,4,0,0"
					Content="Load older"
					Command="{Binding LoadOlderCommand}"
					IsVisible="{Binding CanLoadOlder}"
				/>
				<TextBlock
					DockPanel.Dock="Bottom"
					Classes="secondary"
					Margin="2,4,0,0"
					Text="Loading older…"
					IsVisible="{Binding IsLoadingOlder}"
				/>
				<ListBox
					ItemsSource="{Binding Rows}"
					SelectedItem="{Binding SelectedRow}"
					Background="Transparent"
				>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:NewsRowViewModel">
							<Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
								<!-- A match of the news alerts: an accent bar in front -->
								<Border
									Width="3"
									Margin="0,1,5,1"
									CornerRadius="1"
									Background="{DynamicResource SystemAccentColor}"
									IsVisible="{Binding IsMatch}"
								/>
								<TextBlock
									Grid.Column="1"
									Classes="secondary"
									VerticalAlignment="Center"
									FontFeatures="tnum"
									Text="{Binding TimeText}"
								/>
								<Border Grid.Column="2" Classes="badge">
									<TextBlock Text="{Binding Provider}" />
								</Border>
								<TextBlock
									Grid.Column="3"
									VerticalAlignment="Center"
									FontSize="13"
									Classes.match="{Binding IsMatch}"
									TextTrimming="CharacterEllipsis"
									Text="{Binding Text}"
									ToolTip.Tip="{Binding Text}"
								/>
								<TextBlock
									Grid.Column="4"
									Margin="6,0,0,0"
									VerticalAlignment="Center"
									FontSize="10"
									Classes="secondary"
									Classes.positive="{Binding IsPositive}"
									Classes.negative="{Binding IsNegative}"
									Text="{Binding SentimentMarker}"
									ToolTip.Tip="{Binding SentimentTip}"
									IsVisible="{Binding HasSentiment}"
								/>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>

			<GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

			<!-- Reading pane: plain text only (HTML is turned into text) -->
			<Border
				Grid.Column="2"
				BorderBrush="{DynamicResource PanelStroke}"
				BorderThickness="1,0,0,0"
				Padding="10,0,0,0"
			>
				<Panel>
					<TextBlock
						Classes="secondary"
						Text="Select a headline to read it."
						IsVisible="{Binding !HasArticle}"
					/>
					<DockPanel IsVisible="{Binding HasArticle}">
						<StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
							<SelectableTextBlock
								FontWeight="SemiBold"
								FontSize="14"
								TextWrapping="Wrap"
								Text="{Binding ArticleTitle}"
							/>
							<TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding ArticleMeta}" />
							<TextBlock
								Classes="secondary"
								Text="Loading…"
								IsVisible="{Binding IsArticleLoading}"
							/>
							<TextBlock
								Classes="negative"
								TextWrapping="Wrap"
								Text="{Binding ArticleError}"
								IsVisible="{Binding ArticleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							/>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<Button
									Content="Open document"
									Click="OnOpenDocumentClick"
									IsVisible="{Binding IsArticleDocument}"
								/>
								<Button
									Content="Open in browser"
									ToolTip.Tip="{Binding ArticleUrl}"
									Click="OnOpenInBrowserClick"
									IsVisible="{Binding HasArticleUrl}"
								/>
							</StackPanel>
						</StackPanel>
						<ScrollViewer HorizontalScrollBarVisibility="Disabled">
							<SelectableTextBlock
								FontSize="13"
								LineHeight="19"
								TextWrapping="Wrap"
								Text="{Binding ArticleText}"
							/>
						</ScrollViewer>
					</DockPanel>
				</Panel>
			</Border>
		</Grid>
	</DockPanel>
</UserControl>
