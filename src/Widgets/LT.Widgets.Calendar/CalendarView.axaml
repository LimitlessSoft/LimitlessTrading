<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Calendar"
	xmlns:controls="using:LT.App.Controls"
	x:Class="LT.App.Widgets.Calendar.CalendarView"
	x:DataType="vm:CalendarViewModel"
>
	<!-- Toolbar (range, event type, refresh, sources), state lines, then one list: day headers,
	     each followed by its events, and a "now" line between the past events (dimmed) and the
	     ones to come. A notice replaces the list when no source answered -->
	<DockPanel>
		<DockPanel.Styles>
			<Style Selector="ToggleButton.mode">
				<Setter Property="Padding" Value="10,3" />
				<Setter Property="MinHeight" Value="0" />
				<Setter Property="FontSize" Value="12" />
			</Style>
			<Style Selector="Border.badge">
				<Setter Property="Background" Value="{DynamicResource PanelStroke}" />
				<Setter Property="CornerRadius" Value="3" />
				<Setter Property="Padding" Value="4,0" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="HorizontalAlignment" Value="Left" />
			</Style>
			<Style Selector="Border.badge TextBlock">
				<Setter Property="FontSize" Value="10" />
				<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			</Style>
			<Style Selector="ListBoxItem" x:DataType="vm:CalendarItemViewModel">
				<Setter Property="Padding" Value="6,3" />
				<Setter Property="MinHeight" Value="0" />
				<!-- Day headers group the events; only events can be clicked -->
				<Setter Property="IsHitTestVisible" Value="{Binding IsSelectable}" />
			</Style>
			<!-- Past events and days: dimmed, still readable; an earnings report's result (actual,
			     surprise) stays at full strength, it is what a past row is read for -->
			<Style Selector="StackPanel.event.past :is(Control).dim">
				<Setter Property="Opacity" Value="0.45" />
			</Style>
			<Style Selector="StackPanel.event.past TextBlock.estimate">
				<Setter Property="Opacity" Value="0.7" />
			</Style>
			<!-- Earnings figures: fixed-width, right-aligned columns with tabular digits; the
			     captions over them sit in the day's header -->
			<Style Selector="TextBlock.figure">
				<Setter Property="Width" Value="62" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="FontFeatures" Value="+tnum" />
				<Setter Property="TextAlignment" Value="Right" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
			<Style Selector="TextBlock.caption">
				<Setter Property="Width" Value="62" />
				<Setter Property="FontSize" Value="10" />
				<Setter Property="TextAlignment" Value="Right" />
				<Setter Property="VerticalAlignment" Value="Bottom" />
				<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			</Style>
			<Style Selector="StackPanel.day.past">
				<Setter Property="Opacity" Value="0.6" />
			</Style>
			<Style Selector="StackPanel.day.today TextBlock.dayTitle">
				<Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
			</Style>
			<Style Selector="StackPanel.day.today Border.dayRule">
				<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			</Style>
			<Style Selector="Border#Notice">
				<Setter Property="Background" Value="{DynamicResource PanelBackground}" />
				<Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="4" />
				<Setter Property="Padding" Value="10,8" />
			</Style>
		</DockPanel.Styles>

		<WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
			<StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,12,4">
				<ToggleButton
					Classes="mode"
					Content="Today"
					ToolTip.Tip="Today's events (New York date); clicking a checked range scrolls back to now"
					IsChecked="{Binding IsToday}"
				/>
				<ToggleButton Classes="mode" Content="This week" IsChecked="{Binding IsThisWeek}" />
				<ToggleButton Classes="mode" Content="Next week" IsChecked="{Binding IsNextWeek}" />
				<ToggleButton Classes="mode" Content="This month" IsChecked="{Binding IsThisMonth}" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,12,4">
				<ToggleButton Classes="mode" Content="All" IsChecked="{Binding IsAllEvents}" />
				<ToggleButton
					Classes="mode"
					Content="Earnings"
					ToolTip.Tip="Earnings dates only"
					IsChecked="{Binding IsEarnings}"
				/>
				<ToggleButton
					Classes="mode"
					Content="Economic"
					ToolTip.Tip="Economic releases: GDP, inflation, jobs, central bank speeches, bond auctions, holidays (Nasdaq)"
					IsChecked="{Binding IsEconomic}"
				/>
				<ToggleButton
					Classes="mode"
					Content="Other events"
					ToolTip.Tip="Corporate events other than earnings: ex-dividend dates, splits, conferences, meetings"
					IsChecked="{Binding IsOtherEvents}"
				/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
				<Button
					Padding="10,3"
					MinHeight="0"
					FontSize="12"
					Content="Refresh"
					Command="{Binding RefreshCommand}"
				/>
				<Button
					Padding="10,3"
					MinHeight="0"
					FontSize="12"
					Content="Sources…"
					ToolTip.Tip="Settings → Calendar: switch Nasdaq and IB Wall Street Horizon on or off"
					Command="{Binding OpenSourcesCommand}"
				/>
			</StackPanel>
		</WrapPanel>

		<StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
			<TextBlock
				Classes="secondary"
				Text="{Binding StatusText}"
				IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			/>
			<TextBlock
				Classes="warning"
				FontSize="11"
				TextWrapping="Wrap"
				Text="{Binding SourceWarningText}"
				IsVisible="{Binding HasSourceWarning}"
			/>
			<TextBlock
				Classes="negative"
				TextWrapping="Wrap"
				Text="{Binding ErrorMessage}"
				IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			/>
		</StackPanel>

		<Border x:Name="Notice" DockPanel.Dock="Top" IsVisible="{Binding HasNotice}">
			<StackPanel Spacing="4">
				<TextBlock
					FontWeight="SemiBold"
					Foreground="{DynamicResource WarningBrush}"
					Text="{Binding NoticeTitle}"
				/>
				<SelectableTextBlock TextWrapping="Wrap" Text="{Binding NoticeText}" />
			</StackPanel>
		</Border>

		<TextBlock
			DockPanel.Dock="Top"
			Classes="secondary"
			Margin="0,8,0,0"
			HorizontalAlignment="Center"
			TextWrapping="Wrap"
			Text="{Binding EmptyText}"
			IsVisible="{Binding HasEmptyText}"
		/>

		<ListBox x:Name="EventList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
			<ListBox.DataTemplates>
				<DataTemplate DataType="vm:CalendarDayHeaderViewModel">
					<StackPanel
						Classes="day"
						Classes.today="{Binding IsToday}"
						Classes.past="{Binding IsPast}"
						Margin="0,6,0,0"
					>
						<Grid ColumnDefinitions="*,Auto,Auto">
							<TextBlock Classes="dayTitle" FontWeight="SemiBold" Text="{Binding Title}" />
							<TextBlock
								Grid.Column="1"
								Classes="secondary"
								FontSize="11"
								VerticalAlignment="Bottom"
								Text="{Binding CountText}"
							/>
							<StackPanel
								Grid.Column="2"
								Margin="8,0,0,0"
								Orientation="Horizontal"
								IsVisible="{Binding ShowsCaptions}"
							>
								<TextBlock Classes="caption" Text="Est." ToolTip.Tip="Consensus EPS estimate" />
								<TextBlock
									Classes="caption"
									Text="Actual"
									ToolTip.Tip="Reported EPS (Nasdaq lists it from the day after the report)"
								/>
								<TextBlock
									Classes="caption"
									Text="Surprise"
									ToolTip.Tip="Reported EPS against the estimate: green a beat, red a miss"
								/>
							</StackPanel>
						</Grid>
						<TextBlock
							Classes="warning"
							FontSize="11"
							TextWrapping="Wrap"
							Text="{Binding Warning}"
							IsVisible="{Binding HasWarning}"
						/>
						<Border
							Classes="dayRule"
							Height="1"
							Margin="0,3,0,0"
							Background="{DynamicResource PanelStroke}"
						/>
					</StackPanel>
				</DataTemplate>
				<DataTemplate DataType="vm:CalendarNowMarkerViewModel">
					<DockPanel Margin="0,1">
						<TextBlock
							DockPanel.Dock="Left"
							Margin="0,0,6,0"
							FontSize="10"
							FontWeight="SemiBold"
							VerticalAlignment="Center"
							Foreground="{DynamicResource SystemAccentColor}"
							Text="Now"
						/>
						<Border
							Height="1"
							VerticalAlignment="Center"
							Background="{DynamicResource SystemAccentColor}"
						/>
					</DockPanel>
				</DataTemplate>
				<DataTemplate DataType="vm:CalendarEventRowViewModel">
					<!-- A release's flag on the left (its country in the tooltip); on the right either
					     an earnings report's figure columns or the detail with the type (the country
					     as text only when no flag is drawn for it) -->
					<StackPanel
						Classes="event"
						Classes.past="{Binding IsPast}"
						Background="Transparent"
						ToolTip.Tip="{Binding ToolTipText}"
					>
						<!-- The figure columns' captions, when the day's header can't have them -->
						<StackPanel
							Classes="dim"
							Margin="0,2,0,2"
							HorizontalAlignment="Right"
							Orientation="Horizontal"
							IsVisible="{Binding ShowsCaptions}"
						>
							<TextBlock Classes="caption" Text="Est." ToolTip.Tip="Consensus EPS estimate" />
							<TextBlock
								Classes="caption"
								Text="Actual"
								ToolTip.Tip="Reported EPS (Nasdaq lists it from the day after the report)"
							/>
							<TextBlock
								Classes="caption"
								Text="Surprise"
								ToolTip.Tip="Reported EPS against the estimate: green a beat, red a miss"
							/>
						</StackPanel>
						<Grid ColumnDefinitions="24,92,64,*,Auto">
							<controls:CountryFlag
								Grid.Column="0"
								Classes="dim"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Code="{Binding FlagCode}"
								IsVisible="{Binding HasFlag}"
								ToolTip.Tip="{Binding Event.TypeName}"
							/>
							<Border Grid.Column="1" Classes="badge dim" IsVisible="{Binding HasTime}">
								<TextBlock Text="{Binding TimeText}" />
							</Border>
							<TextBlock
								Grid.Column="2"
								Classes="dim"
								FontWeight="SemiBold"
								VerticalAlignment="Center"
								Text="{Binding Event.Symbol}"
							/>
							<TextBlock
								Grid.Column="3"
								Classes="dim"
								VerticalAlignment="Center"
								TextTrimming="CharacterEllipsis"
								Text="{Binding Event.Company}"
							/>
							<StackPanel
								Grid.Column="4"
								Margin="8,0,0,0"
								Orientation="Horizontal"
								IsVisible="{Binding ShowsFigures}"
							>
								<TextBlock Classes="figure estimate" Text="{Binding EstimateText}" />
								<TextBlock Classes="figure" Text="{Binding ActualText}" />
								<TextBlock
									Classes="figure"
									Classes.positive="{Binding IsBeat}"
									Classes.negative="{Binding IsMiss}"
									Text="{Binding SurpriseText}"
								/>
							</StackPanel>
							<StackPanel
								Grid.Column="4"
								Classes="dim"
								Margin="8,0,0,0"
								Orientation="Horizontal"
								Spacing="8"
								IsVisible="{Binding ShowsDetail}"
							>
								<TextBlock
									FontSize="11"
									VerticalAlignment="Center"
									Text="{Binding Event.Detail}"
									IsVisible="{Binding HasDetail}"
								/>
								<TextBlock
									Classes="secondary"
									FontSize="11"
									VerticalAlignment="Center"
									Text="{Binding Event.TypeName}"
									IsVisible="{Binding ShowsTypeName}"
								/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</DataTemplate>
			</ListBox.DataTemplates>
		</ListBox>
	</DockPanel>
</UserControl>
