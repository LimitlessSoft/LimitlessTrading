<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.OptionChain"
	xmlns:enums="using:LT.Contracts.Enums"
	x:Class="LT.App.Widgets.OptionChain.OptionChainView"
	x:DataType="vm:OptionChainViewModel"
>
	<UserControl.Resources>
		<!-- Arrow fades: solid panel color at the edge, clear toward the tabs -->
		<LinearGradientBrush x:Key="StripFadeLeft" StartPoint="0%,0%" EndPoint="100%,0%">
			<GradientStop Offset="0.45" Color="#1B1E24" />
			<GradientStop Offset="1" Color="#001B1E24" />
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="StripFadeRight" StartPoint="0%,0%" EndPoint="100%,0%">
			<GradientStop Offset="0" Color="#001B1E24" />
			<GradientStop Offset="0.55" Color="#1B1E24" />
		</LinearGradientBrush>
	</UserControl.Resources>

	<!-- The underlying comes from the link group and is shown in the frame header; one tab per
	     expiration (nearest first), each loading the strikes around the money -->
	<DockPanel>
		<DockPanel.Styles>
			<!-- The theme's selection underline overlaps a two-line header: drawn in the template instead -->
			<Style Selector="TabStripItem">
				<Setter Property="Padding" Value="10,3" />
				<Setter Property="MinHeight" Value="0" />
				<Setter Property="FontSize" Value="13" />
			</Style>
			<Style Selector="TabStripItem /template/ Border#PART_SelectedPipe">
				<Setter Property="IsVisible" Value="False" />
			</Style>
			<Style Selector="Border.selectionBar">
				<Setter Property="Height" Value="2" />
				<Setter Property="Margin" Value="0,3,0,0" />
				<Setter Property="CornerRadius" Value="1" />
				<Setter Property="Background" Value="Transparent" />
			</Style>
			<Style Selector="Border.selectionBar.on">
				<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			</Style>
			<!-- Arrows over the strip's ends, fading into the panel so labels slide under them -->
			<Style Selector="Button.stripArrow">
				<Setter Property="Width" Value="36" />
				<Setter Property="VerticalAlignment" Value="Stretch" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="CornerRadius" Value="0" />
				<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
			</Style>
			<Style Selector="Button.stripArrow PathIcon">
				<Setter Property="Width" Value="10" />
				<Setter Property="Height" Value="10" />
			</Style>
			<!-- Every state keeps the fade (the theme's hover box would show the tabs through it);
			     hover only brightens the chevron -->
			<Style Selector="Button.stripArrow.left">
				<Setter Property="Background" Value="{StaticResource StripFadeLeft}" />
			</Style>
			<Style Selector="Button.stripArrow.right">
				<Setter Property="Background" Value="{StaticResource StripFadeRight}" />
			</Style>
			<Style Selector="Button.stripArrow.left:pointerover /template/ ContentPresenter, Button.stripArrow.left:pressed /template/ ContentPresenter">
				<Setter Property="Background" Value="{StaticResource StripFadeLeft}" />
				<Setter Property="Foreground" Value="White" />
			</Style>
			<Style Selector="Button.stripArrow.right:pointerover /template/ ContentPresenter, Button.stripArrow.right:pressed /template/ ContentPresenter">
				<Setter Property="Background" Value="{StaticResource StripFadeRight}" />
				<Setter Property="Foreground" Value="White" />
			</Style>
		</DockPanel.Styles>
		<!-- Expiration tabs: no visible scrollbar; the wheel and the arrows scroll them -->
		<Panel DockPanel.Dock="Top" Margin="0,0,0,4" IsVisible="{Binding Expirations.Count}">
			<ScrollViewer
				x:Name="ExpirationScroll"
				HorizontalScrollBarVisibility="Hidden"
				VerticalScrollBarVisibility="Disabled"
			>
				<TabStrip ItemsSource="{Binding Expirations}" SelectedItem="{Binding SelectedExpiration}">
					<TabStrip.ItemTemplate>
						<DataTemplate x:DataType="vm:ExpirationTab">
							<StackPanel HorizontalAlignment="Center">
								<TextBlock HorizontalAlignment="Center" Text="{Binding Label}" />
								<TextBlock
									HorizontalAlignment="Center"
									Classes="secondary"
									FontSize="11"
									Text="{Binding DaysText}"
								/>
								<!-- Always takes its space, so selecting a tab doesn't change its height -->
								<Border
									Classes="selectionBar"
									Classes.on="{Binding $parent[TabStripItem].IsSelected}"
								/>
							</StackPanel>
						</DataTemplate>
					</TabStrip.ItemTemplate>
				</TabStrip>
			</ScrollViewer>
			<Button
				x:Name="ScrollLeftButton"
				Classes="stripArrow left"
				HorizontalAlignment="Left"
				HorizontalContentAlignment="Left"
				ToolTip.Tip="Earlier expirations"
				IsVisible="False"
			>
				<PathIcon Data="{StaticResource ChevronDownIcon}" Margin="4,0,0,0">
					<PathIcon.RenderTransform>
						<RotateTransform Angle="90" />
					</PathIcon.RenderTransform>
				</PathIcon>
			</Button>
			<Button
				x:Name="ScrollRightButton"
				Classes="stripArrow right"
				HorizontalAlignment="Right"
				HorizontalContentAlignment="Right"
				ToolTip.Tip="Later expirations"
				IsVisible="False"
			>
				<PathIcon Data="{StaticResource ChevronDownIcon}" Margin="0,0,4,0">
					<PathIcon.RenderTransform>
						<RotateTransform Angle="-90" />
					</PathIcon.RenderTransform>
				</PathIcon>
			</Button>
		</Panel>
		<!-- Status line; the one-click quantity sits at its right, in sight while clicking cells.
		     No Maximum: a typo above the cap stays visible and is refused on click instead of being
		     clamped into a 100-contract order -->
		<DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
			<!-- Which quote columns show, on both sides; also on a header's right-click -->
			<Button
				x:Name="ColumnsButton"
				DockPanel.Dock="Right"
				Margin="8,0,0,0"
				VerticalAlignment="Center"
				Content="Columns"
				ToolTip.Tip="Show or hide columns (also: right-click a column header)"
			/>
			<StackPanel
				DockPanel.Dock="Right"
				Orientation="Horizontal"
				Spacing="6"
				VerticalAlignment="Center"
				ToolTip.Tip="Contracts per one-click order (ask buys, bid sells)"
			>
				<TextBlock Classes="secondary" VerticalAlignment="Center" Text="Qty" />
				<NumericUpDown
					Classes="compact"
					Width="76"
					FormatString="0"
					Increment="1"
					Minimum="1"
					ParsingNumberStyle="Integer"
					Value="{Binding QuickOrderQuantity}"
				/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<TextBlock Classes="secondary" Text="Loading…" IsVisible="{Binding IsLoading}" />
				<TextBlock Classes="secondary" Text="{Binding InfoText}" />
				<TextBlock
					Classes="positive"
					Text="{Binding TradeStatus}"
					IsVisible="{Binding TradeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				/>
				<TextBlock
					Classes="negative"
					TextWrapping="Wrap"
					Text="{Binding ErrorMessage}"
					IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				/>
			</StackPanel>
		</DockPanel>
		<DataGrid
			x:Name="StrikesGrid"
			ItemsSource="{Binding Rows}"
			IsReadOnly="True"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
		>
			<DataGrid.Styles>
				<!-- Columns share the width; centred so calls and puts mirror around the strike -->
				<Style Selector="DataGridCell">
					<Setter Property="HorizontalContentAlignment" Value="Center" />
				</Style>
				<!-- Cells stay full width so the ATM and in-the-money shading spans them -->
				<Style Selector="DataGridCell.strike, DataGridCell.quote">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				</Style>
				<Style Selector="DataGridColumnHeader">
					<Setter Property="HorizontalContentAlignment" Value="Center" />
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
					<Setter Property="FontSize" Value="12" />
				</Style>
				<Style Selector="Border.strike">
					<Setter Property="Padding" Value="12,0" />
					<Setter Property="BorderThickness" Value="1" />
					<Setter Property="BorderBrush" Value="Transparent" />
				</Style>
				<!-- Strikes by distance from the price in σ of the expected move, fading out with
				     distance; no colour while the IV (or price) is unknown -->
				<Style Selector="Border.strike.sigma1">
					<Setter Property="Background" Value="{DynamicResource SigmaOneBrush}" />
				</Style>
				<Style Selector="Border.strike.sigma2">
					<Setter Property="Background" Value="{DynamicResource SigmaTwoBrush}" />
				</Style>
				<Style Selector="Border.strike.sigma3">
					<Setter Property="Background" Value="{DynamicResource SigmaThreeBrush}" />
				</Style>
				<Style Selector="Border.strike.sigma4">
					<Setter Property="Background" Value="{DynamicResource SigmaBeyondBrush}" />
				</Style>
				<!-- ATM: an accent outline, so it reads on top of any band colour -->
				<Style Selector="Border.strike.atm">
					<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
				</Style>
				<!-- Calls' cells are tinted green, puts' red; in the money (calls below the
				     underlying price, puts above it) the tint is stronger. The strike column belongs
				     to neither side and keeps its σ colouring -->
				<Style Selector="Border.call">
					<Setter Property="Background" Value="{DynamicResource CallSideBrush}" />
				</Style>
				<Style Selector="Border.call.itm">
					<Setter Property="Background" Value="{DynamicResource CallItmBrush}" />
				</Style>
				<Style Selector="Border.put">
					<Setter Property="Background" Value="{DynamicResource PutSideBrush}" />
				</Style>
				<Style Selector="Border.put.itm">
					<Setter Property="Background" Value="{DynamicResource PutItmBrush}" />
				</Style>
				<!-- Strike cell: its call half (calls' side) and put half open an order ticket for
				     that option. Transparent over the σ colour; hovering the cell shows the C / P
				     badges, the half under the pointer brightens its own -->
				<Style Selector="Button.strikeHalf">
					<Setter Property="HorizontalAlignment" Value="Stretch" />
					<Setter Property="VerticalAlignment" Value="Stretch" />
					<Setter Property="VerticalContentAlignment" Value="Center" />
					<Setter Property="Padding" Value="3,0" />
					<Setter Property="MinHeight" Value="0" />
					<Setter Property="CornerRadius" Value="0" />
					<Setter Property="BorderThickness" Value="0" />
					<Setter Property="Background" Value="Transparent" />
				</Style>
				<Style Selector="Button.strikeHalf.call">
					<Setter Property="HorizontalContentAlignment" Value="Left" />
				</Style>
				<Style Selector="Button.strikeHalf.put">
					<Setter Property="HorizontalContentAlignment" Value="Right" />
				</Style>
				<Style Selector="Button.strikeHalf:not(:disabled)">
					<Setter Property="Cursor" Value="Hand" />
				</Style>
				<Style Selector="Button.strikeHalf:pressed">
					<Setter Property="RenderTransform" Value="none" />
				</Style>
				<Style Selector="Button.strikeHalf:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.strikeHalf:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.strikeHalf:disabled /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Background" Value="Transparent" />
				</Style>
				<Style Selector="Border.badge">
					<Setter Property="Opacity" Value="0" />
					<Setter Property="CornerRadius" Value="3" />
					<Setter Property="Padding" Value="4,0" />
				</Style>
				<Style Selector="Border.badge TextBlock">
					<Setter Property="FontSize" Value="10" />
					<Setter Property="FontWeight" Value="SemiBold" />
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="Border.badge.call">
					<Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
				</Style>
				<Style Selector="Border.badge.put">
					<Setter Property="Background" Value="{DynamicResource NegativeBrush}" />
				</Style>
				<Style Selector="Grid.strikeCell:pointerover Button.strikeHalf:not(:disabled) Border.badge">
					<Setter Property="Opacity" Value="0.45" />
				</Style>
				<Style Selector="Grid.strikeCell Button.strikeHalf:pointerover:not(:disabled) Border.badge">
					<Setter Property="Opacity" Value="1" />
				</Style>
				<!-- One-click trading: ask cells buy, bid cells sell. Only they get the hand cursor
				     and a translucent buy / sell tint on hover, drawn over the ITM shade; disabled
				     (no connection, contract or price) they look like plain text. Ask cells'
				     tooltips show the estimated cost, and also show while disabled ("No price") -->
				<Style Selector="Button.quickTrade">
					<Setter Property="HorizontalAlignment" Value="Stretch" />
					<Setter Property="VerticalAlignment" Value="Stretch" />
					<Setter Property="HorizontalContentAlignment" Value="Center" />
					<Setter Property="VerticalContentAlignment" Value="Center" />
					<Setter Property="Padding" Value="0" />
					<Setter Property="MinHeight" Value="0" />
					<Setter Property="CornerRadius" Value="0" />
					<Setter Property="BorderThickness" Value="0" />
					<Setter Property="Background" Value="Transparent" />
				</Style>
				<Style Selector="Button.quickTrade:not(:disabled)">
					<Setter Property="Cursor" Value="Hand" />
				</Style>
				<Style Selector="Button.quickTrade:pressed">
					<Setter Property="RenderTransform" Value="none" />
				</Style>
				<Style Selector="Button.quickTrade:disabled /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
				</Style>
				<Style Selector="Button.quickTrade.buy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Background" Value="{DynamicResource BuyHoverBrush}" />
				</Style>
				<Style Selector="Button.quickTrade.buy:pressed /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Background" Value="{DynamicResource BuyPressedBrush}" />
				</Style>
				<Style Selector="Button.quickTrade.sell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Background" Value="{DynamicResource SellHoverBrush}" />
				</Style>
				<Style Selector="Button.quickTrade.sell:pressed /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Background" Value="{DynamicResource SellPressedBrush}" />
				</Style>
			</DataGrid.Styles>
			<DataGrid.Columns>
				<DataGridTemplateColumn
					Header="Call vol"
					Width="*"
					CellStyleClasses="quote"
					Tag="{x:Static enums:OptionQuoteColumn.Volume}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Border Classes="call" Classes.itm="{Binding IsCallInTheMoney}">
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Text="{Binding CallVolume}"
								/>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="Call last"
					Width="*"
					CellStyleClasses="quote"
					Tag="{x:Static enums:OptionQuoteColumn.Last}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Border Classes="call" Classes.itm="{Binding IsCallInTheMoney}">
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Text="{Binding CallLast}"
								/>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="Call ask"
					Width="*"
					CellStyleClasses="quote"
					Tag="{x:Static enums:OptionQuoteColumn.Ask}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Border Classes="call" Classes.itm="{Binding IsCallInTheMoney}">
								<Button
									Classes="quickTrade buy"
									Command="{Binding BuyCallCommand}"
									ToolTip.Tip="{Binding CallBuyTip}"
									ToolTip.ShowOnDisabled="True"
								>
									<TextBlock Text="{Binding CallAsk}" />
								</Button>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="Call bid"
					Width="*"
					CellStyleClasses="quote"
					Tag="{x:Static enums:OptionQuoteColumn.Bid}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Border Classes="call" Classes.itm="{Binding IsCallInTheMoney}">
								<Button
									Classes="quickTrade sell"
									Command="{Binding SellCallCommand}"
									ToolTip.Tip="Sell 1 call at market — sends on click"
								>
									<TextBlock Text="{Binding CallBid}" />
								</Button>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="Strike" Width="*" CellStyleClasses="strike">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Grid Classes="strikeCell" ColumnDefinitions="*,*">
								<Border
									Grid.ColumnSpan="2"
									Classes="strike"
									Classes.atm="{Binding IsAtm}"
									Classes.sigma1="{Binding IsWithinOneSigma}"
									Classes.sigma2="{Binding IsWithinTwoSigma}"
									Classes.sigma3="{Binding IsWithinThreeSigma}"
									Classes.sigma4="{Binding IsBeyondThreeSigma}"
								>
									<TextBlock
										FontWeight="SemiBold"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Text="{Binding StrikeText}"
									/>
								</Border>
								<Button
									Grid.Column="0"
									Classes="strikeHalf call"
									Command="{Binding OpenCallTicketCommand}"
									ToolTip.Tip="{Binding CallTicketTip}"
									ToolTip.ShowOnDisabled="True"
								>
									<Border Classes="badge call">
										<TextBlock Text="C" />
									</Border>
								</Button>
								<Button
									Grid.Column="1"
									Classes="strikeHalf put"
									Command="{Binding OpenPutTicketCommand}"
									ToolTip.Tip="{Binding PutTicketTip}"
									ToolTip.ShowOnDisabled="True"
								>
									<Border Classes="badge put">
										<TextBlock Text="P" />
									</Border>
								</Button>
							</Grid>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="Put bid"
					Width="*"
					CellStyleClasses="quote"
					Tag="{x:Static enums:OptionQuoteColumn.Bid}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Border Classes="put" Classes.itm="{Binding IsPutInTheMoney}">
								<Button
									Classes="quickTrade sell"
									Command="{Binding SellPutCommand}"
									ToolTip.Tip="Sell 1 put at market — sends on click"
								>
									<TextBlock Text="{Binding PutBid}" />
								</Button>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="Put ask"
					Width="*"
					CellStyleClasses="quote"
					Tag="{x:Static enums:OptionQuoteColumn.Ask}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Border Classes="put" Classes.itm="{Binding IsPutInTheMoney}">
								<Button
									Classes="quickTrade buy"
									Command="{Binding BuyPutCommand}"
									ToolTip.Tip="{Binding PutBuyTip}"
									ToolTip.ShowOnDisabled="True"
								>
									<TextBlock Text="{Binding PutAsk}" />
								</Button>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="Put last"
					Width="*"
					CellStyleClasses="quote"
					Tag="{x:Static enums:OptionQuoteColumn.Last}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Border Classes="put" Classes.itm="{Binding IsPutInTheMoney}">
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Text="{Binding PutLast}"
								/>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn
					Header="Put vol"
					Width="*"
					CellStyleClasses="quote"
					Tag="{x:Static enums:OptionQuoteColumn.Volume}"
				>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="vm:OptionRowViewModel">
							<Border Classes="put" Classes.itm="{Binding IsPutInTheMoney}">
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Text="{Binding PutVolume}"
								/>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
