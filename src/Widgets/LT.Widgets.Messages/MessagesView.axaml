<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Messages"
	x:Class="LT.App.Widgets.Messages.MessagesView"
	x:DataType="vm:MessagesViewModel"
>
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
			<Button Content="Clear" Command="{Binding ClearCommand}" />
			<TextBlock
				VerticalAlignment="Center"
				Classes="secondary"
				Text="App events: connection, market data and chart errors. IB's own system messages are not shown here yet."
			/>
		</StackPanel>
		<DataGrid
			x:Name="Grid"
			ItemsSource="{Binding Messages}"
			IsReadOnly="True"
			SelectionMode="Extended"
			ClipboardCopyMode="None"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
		>
			<DataGrid.ContextMenu>
				<ContextMenu Opening="OnMenuOpening">
					<MenuItem x:Name="CopyItem" Header="Copy" InputGesture="Ctrl+C" Click="OnCopyClick" />
				</ContextMenu>
			</DataGrid.ContextMenu>
			<DataGrid.Columns>
				<DataGridTextColumn
					x:DataType="vm:MessageRowViewModel"
					Header="Time"
					Binding="{Binding TimeText}"
				/>
				<DataGridTextColumn
					x:DataType="vm:MessageRowViewModel"
					Header="Level"
					Binding="{Binding Message.Severity}"
				/>
				<DataGridTextColumn
					x:DataType="vm:MessageRowViewModel"
					Header="Source"
					Binding="{Binding Message.Source}"
				/>
				<DataGridTextColumn
					x:DataType="vm:MessageRowViewModel"
					Header="Message"
					Binding="{Binding Message.Text}"
					Width="*"
				/>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
