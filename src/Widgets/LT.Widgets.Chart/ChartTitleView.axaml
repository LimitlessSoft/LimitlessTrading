<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Chart"
	xmlns:controls="using:LT.App.Controls"
	x:Class="LT.App.Widgets.Chart.ChartTitleView"
	x:DataType="vm:ChartViewModel"
>
	<!-- Chart header title: click it to type a ticker (IB listings are suggested) or pick a recent one;
	     click the timeframe next to it to pick another bar size, ƒx to add an indicator -->
	<StackPanel Orientation="Horizontal" Spacing="2">
		<Panel>
			<Button
				x:Name="TitleButton"
				Classes="chartTitle"
				Content="{Binding Title}"
				ToolTip.Tip="Click to change the ticker"
			/>
			<StackPanel x:Name="Editor" Orientation="Horizontal" Spacing="2" IsVisible="False">
				<controls:ContractSearchBox
					x:Name="TickerBox"
					Width="360"
					Placeholder="Ticker, e.g. AAPL"
				/>
				<Button x:Name="RecentButton" Classes="frameAction" ToolTip.Tip="Recent tickers">
					<PathIcon Data="{StaticResource ChevronDownIcon}" />
				</Button>
			</StackPanel>
		</Panel>
		<Button
			x:Name="TimeframeButton"
			Classes="chartTimeframe"
			Content="{Binding SelectedTimeframe}"
			ToolTip.Tip="Click to change the timeframe"
		>
			<Button.Flyout>
				<MenuFlyout Placement="BottomEdgeAlignedLeft" />
			</Button.Flyout>
		</Button>
		<Button
			x:Name="IndicatorsButton"
			Classes="chartTimeframe"
			ToolTip.Tip="Add an indicator"
			IsEnabled="{Binding CanAddIndicator}"
		>
			<TextBlock Text="ƒx" FontStyle="Italic" />
			<Button.Flyout>
				<Flyout Placement="BottomEdgeAlignedLeft">
					<StackPanel Width="320" Spacing="6">
						<TextBox
							x:Name="IndicatorSearchBox"
							PlaceholderText="Search indicators"
							Text="{Binding IndicatorSearch}"
						/>
						<ScrollViewer MaxHeight="360">
							<ItemsControl ItemsSource="{Binding IndicatorChoices}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:IndicatorChoiceItem">
										<Button
											Classes="pickerRow"
											Click="OnIndicatorPicked"
											HorizontalContentAlignment="Stretch"
										>
											<StackPanel Spacing="1">
												<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
													<TextBlock
														VerticalAlignment="Center"
														TextTrimming="CharacterEllipsis"
														Text="{Binding Name}"
													/>
													<TextBlock
														Grid.Column="1"
														Classes="secondary"
														FontSize="12"
														VerticalAlignment="Center"
														Text="{Binding Kind}"
													/>
												</Grid>
												<TextBlock
													Classes="negative"
													FontSize="11"
													TextTrimming="CharacterEllipsis"
													Text="{Binding Error}"
													IsVisible="{Binding HasError}"
												/>
											</StackPanel>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
						<Button
							x:Name="ScriptsFolderButton"
							Classes="pickerRow"
							ToolTip.Tip="Every .cs file there is an indicator; edit them in any editor"
						>
							<TextBlock Classes="secondary" Text="Open the scripts folder…" />
						</Button>
					</StackPanel>
				</Flyout>
			</Button.Flyout>
		</Button>
	</StackPanel>
</UserControl>
