<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Chart"
	xmlns:controls="using:LT.App.Controls"
	x:Class="LT.App.Widgets.Chart.ChartTitleView"
	x:DataType="vm:ChartViewModel"
>
	<!-- Chart header title: click the ticker to type another (IB listings are suggested) or pick a
	     recent one; click the timeframe next to it to pick another bar size, and the period after
	     it to zoom to a span (rolling, then calendar periods; "Custom" once the view was zoomed or
	     scrolled away from it), and RTH / ETH after that
	     (intraday only) to switch between regular hours and pre- and post-market bars, and the bar
	     style last (candles or footprint, per chart).
	     Indicators and templates are in the chart's right-click menu (ChartView). -->
	<StackPanel Orientation="Horizontal" Spacing="2">
		<controls:TickerTitle />
		<Button
			x:Name="TimeframeButton"
			Classes="chartTimeframe"
			Content="{Binding SelectedTimeframe}"
			ToolTip.Tip="Click to change the timeframe"
		>
			<Button.Flyout>
				<MenuFlyout Placement="BottomEdgeAlignedLeft" />
			</Button.Flyout>
		</Button>
		<Button
			x:Name="PeriodButton"
			Classes="chartTimeframe"
			Content="{Binding PeriodLabel}"
			ToolTip.Tip="{Binding PeriodToolTip}"
		>
			<Button.Flyout>
				<MenuFlyout Placement="BottomEdgeAlignedLeft" />
			</Button.Flyout>
		</Button>
		<Button
			Classes="chartTimeframe"
			Content="{Binding TradingHoursLabel}"
			Command="{Binding ToggleTradingHoursCommand}"
			IsVisible="{Binding HasTradingHoursToggle}"
			ToolTip.Tip="{Binding TradingHoursToolTip}"
		/>
		<Button
			Classes="chartTimeframe"
			Content="{Binding BarStyleLabel}"
			Command="{Binding ToggleBarStyleCommand}"
			ToolTip.Tip="{Binding BarStyleToolTip}"
		/>
	</StackPanel>
</UserControl>
