<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:LT.App.Widgets.Chart"
	xmlns:helpers="using:LT.App.Helpers"
	x:Class="LT.App.Widgets.Chart.ChartView"
	x:DataType="vm:ChartViewModel"
>
	<!-- The ticker and timeframe are picked in the frame header (ChartTitleView). RTH / Reload
	     controls are hidden until they are redesigned; the view model keeps their state.
	     A ticker dragged from a watchlist, positions, orders or executions row can be dropped
	     anywhere on the chart (TickerDragDrop); the highlight shows while it hovers. -->
	<Panel x:Name="DropRoot" Background="Transparent" helpers:TickerDragDrop.IsTarget="True">
		<vm:CandlestickChart
			x:Name="Chart"
			Bars="{Binding Bars}"
			Indicators="{Binding IndicatorResults}"
			IsIntraday="{Binding IsIntraday}"
			Timeframe="{Binding SelectedTimeframe.Value}"
			Fills="{Binding Fills}"
			TradeLegs="{Binding TradeLegs}"
			BreakEvenPrice="{Binding BreakEvenPrice}"
			RightMargin="{Binding RightMargin}"
			TimeZone="{Binding DisplayTime.Zone}"
		/>
		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			Margin="8,40,8,8"
			Spacing="2"
			IsHitTestVisible="False"
		>
			<TextBlock Classes="secondary" Text="Loading…" IsVisible="{Binding IsLoading}" />
			<TextBlock
				Classes="negative"
				FontSize="12"
				TextWrapping="Wrap"
				MaxWidth="420"
				Text="{Binding ErrorMessage}"
				IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			/>
		</StackPanel>
		<Border
			Classes="dropTarget"
			Margin="4"
			IsHitTestVisible="False"
			IsVisible="{Binding #DropRoot.(helpers:TickerDragDrop.HoverText), Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
		>
			<TextBlock
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				FontWeight="SemiBold"
				Text="{Binding #DropRoot.(helpers:TickerDragDrop.HoverText)}"
			/>
		</Border>
	</Panel>
</UserControl>
